    height: 32px;
    border-radius: 7px;
    background: linear-gradient(135deg, #d9e542 0%, #5fbf54 45%, #2f7be0 100%);
    color: #fff;
    display: grid;
    place-items: center;
    font: 800 11px/1 var(--ab-pjs);
  }
  .ab-inv-name {
    left: 60px;
    top: 28px;
    font-size: 12px;
    line-height: 15px;
    font-weight: 600;
  }
  .ab-inv-addr {
    left: 60px;
    top: 44px;
    font-size: 10.5px;
    line-height: 13px;
    color: #6b7c94;
  }
  .ab-inv-title-big {
    right: 19px;
    top: 28px;
    font: 800 16px/20px var(--ab-pjs);
    letter-spacing: 0.01em;
  }
  .ab-inv-draft {
    right: 19px;
    top: 49px;
    font-size: 10.5px;
    line-height: 13px;
    color: var(--ab-grey);
  }
  .ab-inv-label {
    left: 19px;
    top: 84px;
    font-size: 9.5px;
    line-height: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ab-grey);
  }
  .ab-inv-cust {
    left: 19px;
    top: 100px;
    font-size: 11px;
    line-height: 14px;
    font-weight: 600;
  }
  .ab-inv-phone {
    left: 19px;
    top: 117px;
    font-size: 10.5px;
    line-height: 13px;
    color: var(--ab-grey);
  }
  /* placeholder → value (live preview filling in) */
  .ab-ph,
  .ab-val {
    display: inline-block;
  }
  .ab-ph {
    display: none;
  }
  .ab-inv-subject {
    left: 19px;
    top: 152px;
    font-size: 12.5px;
    line-height: 16px;
    font-weight: 600;
  }
  .ab-inv-thead,
  .ab-inv-row {
    left: 19px;
    right: 19px;
    height: 24px;
    font-size: 11px;
  }
  .ab-inv-thead {
    top: 176px;
    background: #ecf1f7;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ab-grey);
  }
