</div>

<style>
  @font-face {
    font-family: 'Plus Jakarta Sans AB';
    src: url('/fonts/plus-jakarta-sans-latin-500-800.woff2') format('woff2');
    font-weight: 500 800;
    font-display: swap;
  }
  .ab {
    --ab-navy: #0c1940;
    --ab-ink: #314158;
    --ab-grey: #62748e;
    --ab-line: #e1e7ef;
    --ab-blue: #2154d8;
    --ab-green: #089772;
    --ab-mint: #dff9ee;
    /* Plus Jakarta Sans (headings, figures) is only applied, and so only downloaded, once the deck is
       near (deck.ts sets data-near) or straight away without JavaScript */
    --ab-pjs: 'Inter Variable', 'Inter Fallback', sans-serif;
    position: absolute;
    inset: 0;
    overflow: hidden;
    container-type: size;
    font-family: 'Inter Variable', 'Inter Fallback', sans-serif;
    color: var(--ab-navy);
    -webkit-font-smoothing: antialiased;
  }
  :global(html:not(.js)) .ab,
  :global([data-near]) .ab {
    --ab-pjs: 'Plus Jakarta Sans AB', 'Inter Variable', 'Inter Fallback', sans-serif;
  }
  .ab p {
    margin: 0;
  }
  .ab svg {
    display: block;
  }
  /* The board: 1 board px = 1 screenshot px. Without JavaScript the camera rests on the last beat. */
  .ab-board {
    position: absolute;
    left: 0;
    top: 0;
    width: 1100px;
    height: 1400px;
    transform-origin: 0 0;
    transform: translate(calc(50cqw - 688px * 1.3), calc(50cqh - 1268px * 1.3)) scale(1.3);
  }
  .ab-board > * {
    position: absolute;
  }
  /* With JavaScript, the pieces are only laid out once the deck is near: the rebuild's many font sizes
     and weights cost a first layout of about 250 ms on a mid-range phone, too much for page load.
     deck.ts shows them one per frame, in story order, after the card's font has loaded. */
  :global(html.js) .ab-board > :not([data-shown]) {
    display: none;
  }

  /* Header */
  /* the portal's white header bar (the pieces otherwise sit straight on the dark panel) */
  .ab-header {
    left: -24px;
    top: 0;
    width: 400px;
    height: 52px;
    padding-left: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border-bottom: 1px solid var(--ab-line);
    border-radius: 0 0 10px 0;
  }
  .ab-header img {
    width: 32px;
    height: 32px;
  }
  .ab-brand {
    font: 800 12px/14px var(--ab-pjs);
    letter-spacing: -0.01em;
    color: var(--ab-navy);
  }
  .ab-merchant {
    font-size: 9.5px;
    line-height: 12px;
    color: var(--ab-grey);
  }

  /* Tiles */
  .ab-tile {
    width: 257px;
    height: 64px;
    border: 1px solid var(--ab-line);
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
  }
  .ab-tile-raised {
    box-shadow: 0 4px 10px rgb(15 23 42 / 0.08);
  }
  .ab-tile-off {
    background: #f0f4f9;
  }
  .ab-tile.is-selected {
    height: 65px;
    border: 1.5px solid var(--ab-blue);
    box-shadow: 0 2px 6px rgb(33 84 216 / 0.12);
  }
  .ab-icon {
    position: absolute;
    left: 13px;
    top: 13px;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    display: grid;
    place-items: center;
