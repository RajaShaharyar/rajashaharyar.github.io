      <span class="ab-disb-icon"><svg viewBox="0 0 24 24"><path d="M19 7V5.5A1.5 1.5 0 0 0 17.5 4h-12A1.5 1.5 0 0 0 4 5.5v13A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V17" /><path d="M20.5 9h-5a2 2 0 0 0 0 6h5V9z" /></svg></span>
      <p class="ab-disb-big">Rs 321.5K</p>
      <p class="ab-disb-sub">amount settled to your bank</p>
      <div class="ab-disb-rule"></div>
      <p class="ab-disb-k" style="left:25px"><i style="background:#089772"></i>Settled</p>
      <p class="ab-disb-v" style="left:25px">Rs 321.5K</p>
      <p class="ab-disb-k" style="left:262px"><i style="background:#e9ab2b"></i>In progress</p>
      <p class="ab-disb-v" style="left:262px">Rs 317.1K</p>
    </div>

    <!-- Dashboard: payment analytics donut (on its own, in a rounded square) -->
    <div class="ab-donut" style="left:560px;top:1140px">
      <svg viewBox="0 0 255 255" data-ab-donut="1">
        <defs>
          <linearGradient id="ab-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#36b984" /><stop offset="1" stop-color="#00906e" /></linearGradient>
          <linearGradient id="ab-r" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f05a52" /><stop offset="1" stop-color="#c31843" /></linearGradient>
          <linearGradient id="ab-o" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f6c443" /><stop offset="1" stop-color="#ec9f25" /></linearGradient>
          <linearGradient id="ab-t" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22ae98" /><stop offset="1" stop-color="#3cb3cf" /></linearGradient>
        </defs>
        <!-- arcs: (start°, sweep°) clockwise from 12 o'clock, round caps; pathLength 100 so the script can draw them -->
        <path class="ab-arc" d={arc(127.5, 127.5, 106, 7, 142)} stroke="url(#ab-g)" stroke-width="26" pathLength="100" />
        <path class="ab-arc" d={arc(127.5, 127.5, 106, 169, 179.5)} stroke="url(#ab-r)" stroke-width="26" pathLength="100" />
        <path class="ab-arc" d={arc(127.5, 127.5, 75, 9.5, 145)} stroke="url(#ab-o)" stroke-width="14" pathLength="100" />
        <circle cx="127.5" cy="127.5" r="52" class="ab-donut-disc" />
