---
/**
 * AsaanBill's real merchant-portal UI, rebuilt as live HTML/CSS from the three screenshots in
 * _source/animation-assets/asaanbill/ (create invoice, reports, dashboard): same wording, values,
 * colours, radii and type (Inter for text, Plus Jakarta Sans for headings and figures). Every
 * value shown appears in those screenshots; the story follows one real Reports row (Maintenance
 * Charges – Oct, Ayesha Khan, Rs 166,800). Pieces sit on one board in "board px" (1 board px =
 * 1 screenshot px); the panel is a camera that pans and zooms it (src/scripts/asaanbill-board.ts).
 *
 * The markup is the story's final state (so no-JavaScript and reduced-motion visitors see a
 * complete picture); the script resets it to the first frame and plays the 14 s timeline.
 * Decorative: the whole board is aria-hidden; the meaning is in the card's text.
 */
const mark = '/images/ventures/asaanbill-ui/asaanbill-mark.png';

/** SVG arc: centre, radius, start and sweep in degrees clockwise from 12 o'clock. Round caps add
 * half the stroke at each end, so the visible arcs match the screenshot's (measured by colour). */
function arc(cx: number, cy: number, r: number, start: number, sweep: number) {
  const pt = (deg: number) => {
    const a = ((deg - 90) * Math.PI) / 180;
    return `${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  };
  return `M${pt(start)}A${r} ${r} 0 ${sweep > 180 ? 1 : 0} 1 ${pt(start + sweep)}`;
}
---

