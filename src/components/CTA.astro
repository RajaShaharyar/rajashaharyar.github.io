---
/**
 * Final call to action on the one accent colour (homepage, Work With Me).
 * The button defaults to site.json → cta; pass href (e.g. with ?reason=…) to
 * preselect a reason on the contact form.
 */
import { site } from '../lib/site';

interface Props {
  heading: string;
  href?: string;
  label?: string;
  /** id of the heading, for aria-labelledby on the surrounding section */
  headingId?: string;
}

const { heading, href = site.cta.href, label = site.cta.label, headingId = 'cta-heading' } = Astro.props;
---

<div class="cta relative overflow-hidden rounded-[1.5rem] bg-accent px-6 py-14 text-accent-ink sm:px-10 md:px-16 md:py-20">
  <h2 id={headingId} class="max-w-3xl text-display-lg text-accent-ink">{heading}</h2>
  <a href={href} class="btn btn-dark mt-8">{label}</a>
</div>

<style>
  .cta :focus-visible {
    outline-color: var(--color-accent-ink);
  }
</style>
