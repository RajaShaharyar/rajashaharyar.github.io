---
/** Homepage section 10: final call to action, on the one accent colour. */
import { site } from '../lib/site';

interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<div class="cta relative overflow-hidden rounded-[1.5rem] bg-accent px-6 py-14 text-accent-ink sm:px-10 md:px-16 md:py-20">
  <h2 id="cta-heading" class="max-w-3xl text-display-lg text-accent-ink">{heading}</h2>
  <a href={site.cta.href} class="btn btn-dark mt-8">{site.cta.label}</a>
</div>

<style>
  .cta :focus-visible {
    outline-color: var(--color-accent-ink);
  }
</style>
