---
/**
 * The closing call to action (homepage, Work With Me, the About pages, the venture pages): a contained,
 * rounded panel inside the page width (Phase 18: bright colour lives in cards, not page bands). Solid
 * violet with ink text (10.1:1), a faint grain, and a near-black button with lime text. The button
 * defaults to site.json → cta; pass href (e.g. with ?reason=…) to preselect a reason on the contact form.
 */
import Aurora from './Aurora.astro';
import { site } from '../lib/site';

interface Props {
  heading: string;
  href?: string;
  label?: string;
  /** id of the heading, for aria-labelledby on the section */
  headingId?: string;
}

const { heading, href = site.cta.href, label = site.cta.label, headingId = 'cta-heading' } = Astro.props;
---

<section class="cta wrap defer-render pt-8 md:pt-12" aria-labelledby={headingId}>
  <div class="cta-panel band-violet">
    <Aurora variant="grain" id={`grain-${headingId}`} />
    <h2 id={headingId} class="max-w-3xl text-display-lg">{heading}</h2>
    <a href={href} class="btn btn-dark mt-8">{label} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .cta {
    --defer-size: 26rem;
  }
  .cta-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 3.5rem 1.5rem;
    border-radius: 1.5rem;
  }
  @media (width >= 40rem) {
    .cta-panel {
      padding: 4rem 2.5rem;
    }
  }
  @media (width >= 64rem) {
    .cta-panel {
      padding: 5rem 4rem;
    }
  }
  .cta-panel h2 {
    color: var(--color-accent-2-ink);
  }
</style>
