---
/**
 * One counter (number + label) for the Recognition pages. Renders an <li>:
 * wrap a set of counters in a <ul class="counter-grid">. Values are computed
 * from recognition.json (or read from cv.json), never typed into a page.
 */
interface Props {
  value: string | number;
  label: string;
}

const { value, label } = Astro.props;
---

<li class="counter">
  <span class="counter-value">{value}</span>{' '}<span class="counter-label">{label}</span>
</li>

<style>
  .counter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.25rem 1.375rem;
    background-color: var(--color-bg);
  }
  @media (width >= 48rem) {
    .counter {
      padding: 1.75rem;
    }
  }
  .counter-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
  }
  .counter-label {
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-fg-muted);
  }
</style>
