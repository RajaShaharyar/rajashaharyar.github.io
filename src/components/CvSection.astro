---
/**
 * One numbered section of the web CV (/cv). The id is what the sticky
 * mini-menu links to.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="cv-section" aria-labelledby={`${id}-heading`} data-cv-section>
  <h2 id={`${id}-heading`} class="cv-h2">{title}</h2>
  <div class="cv-section-body">
    <slot />
  </div>
</section>
