---
/**
 * Footer on every page: email, WhatsApp and LinkedIn, then the menu mirrored
 * from site.json → nav (pages, the Ventures dropdown) and the Recognition pages
 * (site.json → recognitionMenu), which are not in the top bar. No CV link: the
 * CV is linked only from the About dropdown (consultation first).
 */
import { site } from '../lib/site';

const { contact } = site;
const year = new Date().getFullYear();
// The top-level pages, with About expanded to its three pages (the CV, also in that menu, is not repeated here).
const pages = [
  ...site.nav.flatMap((item) =>
    item.href === '/about/' ? (item.children ?? []).filter((c) => c.href.startsWith('/about/')).map(({ label, href }) => ({ label, href })) : [{ label: item.label, href: item.href }],
  ),
  site.cta,
];
const venturesMenu = site.nav.find((item) => item.href === '/ventures/');
const recognition = site.recognitionMenu;
---

<footer class="site-footer defer-render" style="--defer-size: 36rem">
  <div class="footer-grid wrap py-14 md:py-16">
    <div class="footer-wide">
      <p class="font-display text-2xl font-bold tracking-tight">
        {site.name}<span class="text-accent-2" aria-hidden="true">.</span>
      </p>
      <p class="mt-2 text-fg-muted">{site.title}, {site.company}</p>
      <p class="text-fg-muted">{site.location.display}</p>
      <a href={site.cta.href} class="link mt-6 inline-block font-semibold">{site.cta.label} →</a>
    </div>

    <div class="footer-wide">
      <h2 class="footer-heading">Get in touch</h2>
      <ul class="footer-list">
        <li>
          <a href={`mailto:${contact.email}`} class="footer-link">
            <span class="footer-key">Email</span>
            <span class="footer-email">{contact.email}</span>
          </a>
        </li>
        <li>
          <a href={contact.whatsapp.href} class="footer-link">
            <span class="footer-key">WhatsApp</span>
            <span>{contact.whatsapp.display}</span>
          </a>
        </li>
        <li>
          <a href={contact.linkedin.href} class="footer-link">
            <span class="footer-key">LinkedIn</span>
            <span>{site.name}</span>
          </a>
        </li>
      </ul>
    </div>

    <nav aria-labelledby="footer-pages-heading">
      <h2 class="footer-heading" id="footer-pages-heading">Pages</h2>
      <ul class="footer-list">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} class="footer-link">
                <span>{p.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-ventures-heading">
      <h2 class="footer-heading" id="footer-ventures-heading">
        <a href={venturesMenu?.href} class="footer-heading-link">{venturesMenu?.label}</a>
      </h2>
      <ul class="footer-list">
        {
          (venturesMenu?.children ?? []).map((v) => (
            <li>
              <a href={v.href} class="footer-link">
                <span>{v.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-recognition-heading">
      <h2 class="footer-heading" id="footer-recognition-heading">
        <a href={recognition.href} class="footer-heading-link">{recognition.label}</a>
      </h2>
      <ul class="footer-list">
        {
          recognition.children.map((r) => (
            <li>
              <a href={r.href} class="footer-link">
                <span>{r.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap border-t border-line py-6 text-sm text-fg-subtle">
    <p>© {year} {site.name}. Based in {site.location.display}.</p>
  </div>
  <!-- The name, set large in an outline: decoration (the name is already read out above). SVG text, so it
       scales to the width exactly (viewBox = its measured size at 100 px: 728 × 100). -->
  <!-- ...and "Entrepreneur" under it, the same size (its measured 536 px at 100 px against the name's 728),
       offset to the right on desktop -->
  <div class="footer-words" aria-hidden="true">
    <svg class="footer-name" viewBox="-4 -86 736 112" focusable="false">
      <text x="0" y="0" textLength="728" lengthAdjust="spacingAndGlyphs">{site.name}</text>
    </svg>
    <svg class="footer-name footer-word" viewBox="-4 -86 544 112" focusable="false">
      <text x="0" y="0" textLength="536" lengthAdjust="spacingAndGlyphs">Entrepreneur</text>
    </svg>
  </div>
</footer>

<style>
  /* Phones: identity and contact across the width, the three link lists two to a row. From 768 px:
     three columns; from 1280 px: all five in one row (at 1024 they were too narrow for the email). */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }
  .footer-wide {
    grid-column: 1 / -1;
  }
  @media (width >= 48rem) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 2rem;
    }
    .footer-wide {
      grid-column: auto;
    }
    .footer-grid > :first-child {
      grid-column: span 2;
    }
  }
  @media (width >= 80rem) {
    .footer-grid {
      grid-template-columns: 1.35fr 1.15fr 0.7fr 0.9fr 1fr;
      gap: 2.5rem;
    }
    .footer-grid > :first-child {
      grid-column: auto;
    }
  }
  /* The address breaks only at its @ or dots, never mid-word */
  .footer-email {
    overflow-wrap: anywhere;
    word-break: normal;
  }
  /* Near-black, with a lime → violet hairline at the top */
  .site-footer {
    position: relative;
    margin-top: 5rem;
    overflow: hidden;
    background-color: var(--color-bg);
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background-image: var(--gradient-brand);
  }
  .footer-words {
    width: min(100% - 2rem, var(--container-page) - 4rem);
    margin: 0 auto 0.75rem;
  }
  .footer-name {
    display: block;
    width: 100%;
    overflow: visible;
    opacity: 0.6;
    user-select: none;
  }
  /* The same type size as the name: its width is the word's share of the name's (544 / 736) */
  .footer-word {
    width: calc(100% * 544 / 736);
    margin-top: -3.5%; /* the two lines sit like one block of type */
  }
  @media (width >= 64rem) {
    .footer-word {
      margin-left: auto; /* offset to the right */
      margin-right: 6%;
    }
  }
  .footer-name text {
    font-family: var(--font-display);
    font-size: 100px;
    font-weight: 700;
    letter-spacing: -0.04em;
    fill: none;
    stroke: var(--color-accent-2-strong);
    stroke-width: 1.2px;
    vector-effect: non-scaling-stroke;
  }
  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .footer-heading-link {
    display: inline-block;
    padding-block: 0.75rem; /* a 44px target without moving the heading */
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.3em;
  }
  .footer-heading-link:hover {
    color: var(--color-fg);
  }
  .footer-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .footer-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    text-decoration: none;
    color: var(--color-fg);
    transition: color 0.15s;
  }
  .footer-link:hover {
    color: var(--color-accent-2);
  }
  .footer-key {
    flex-basis: 100%; /* label above its value, in every row */
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
</style>
