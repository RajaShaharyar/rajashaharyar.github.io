---
/**
 * Footer on every page: email, WhatsApp, LinkedIn and the CV PDF, then the
 * menu mirrored from site.json → nav (pages, the Ventures dropdown) and the
 * Recognition pages (site.json → recognitionMenu), which are not in the top bar.
 */
import { site } from '../lib/site';
import { publicFileExists } from '../lib/public-files';

const { contact, cv } = site;
const year = new Date().getFullYear();
// The CV download row appears automatically once public/cv.pdf exists (hidden until then).
const hasCvPdf = publicFileExists(cv.pdfHref);
const pages = [...site.nav.map(({ label, href }) => ({ label, href })), site.cta];
const venturesMenu = site.nav.find((item) => item.href === '/ventures/');
const recognition = site.recognitionMenu;
---

<footer class="defer-render mt-20 border-t border-line bg-surface md:mt-24" style="--defer-size: 30rem">
  <div class="wrap grid gap-12 py-14 sm:grid-cols-2 md:py-16 lg:grid-cols-[1.35fr_1.15fr_0.7fr_0.9fr_1fr] lg:gap-10">
    <div>
      <p class="font-display text-2xl font-bold tracking-tight">
        {site.name}<span class="text-accent" aria-hidden="true">.</span>
      </p>
      <p class="mt-2 text-fg-muted">{site.title}, {site.company}</p>
      <p class="text-fg-muted">{site.location.display}</p>
      <a href={site.cta.href} class="link mt-6 inline-block font-semibold">{site.cta.label} →</a>
    </div>

    <div>
      <h2 class="footer-heading">Get in touch</h2>
      <ul class="footer-list">
        <li>
          <a href={`mailto:${contact.email}`} class="footer-link">
            <span class="footer-key">Email</span>
            <span class="break-all">{contact.email}</span>
          </a>
        </li>
        <li>
          <a href={contact.whatsapp.href} class="footer-link">
            <span class="footer-key">WhatsApp</span>
            <span>{contact.whatsapp.display}</span>
          </a>
        </li>
        <li>
          <a href={contact.linkedin.href} class="footer-link">
            <span class="footer-key">LinkedIn</span>
            <span>{site.name}</span>
          </a>
        </li>
        {
          hasCvPdf && (
            <li>
              <a href={cv.pdfHref} class="footer-link" download={cv.downloadName}>
                <span class="footer-key">CV</span>
                <span>Download PDF</span>
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <nav aria-labelledby="footer-pages-heading">
      <h2 class="footer-heading" id="footer-pages-heading">Pages</h2>
      <ul class="footer-list">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} class="footer-link">
                <span>{p.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-ventures-heading">
      <h2 class="footer-heading" id="footer-ventures-heading">
        <a href={venturesMenu?.href} class="footer-heading-link">{venturesMenu?.label}</a>
      </h2>
      <ul class="footer-list">
        {
          (venturesMenu?.children ?? []).map((v) => (
            <li>
              <a href={v.href} class="footer-link">
                <span>{v.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-recognition-heading">
      <h2 class="footer-heading" id="footer-recognition-heading">
        <a href={recognition.href} class="footer-heading-link">{recognition.label}</a>
      </h2>
      <ul class="footer-list">
        {
          recognition.children.map((r) => (
            <li>
              <a href={r.href} class="footer-link">
                <span>{r.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap border-t border-line py-6 text-sm text-fg-subtle">
    <p>© {year} {site.name}. Based in {site.location.display}.</p>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .footer-heading-link {
    display: inline-block;
    padding-block: 0.75rem; /* a 44px target without moving the heading */
    margin-block: -0.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 0.3em;
  }
  .footer-heading-link:hover {
    color: var(--color-fg);
  }
  .footer-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .footer-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    text-decoration: none;
    color: var(--color-fg);
    transition: color 0.15s;
  }
  .footer-link:hover {
    color: var(--color-accent);
  }
  .footer-key {
    flex-basis: 100%; /* label above its value, in every row */
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
</style>
