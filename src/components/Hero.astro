---
/**
 * Homepage section 1: who he is in one look.
 * The headline's last word rotates once ("traction." → "businesses." → "revenue.", home.json →
 * hero.rotatingWords) and stops on the last one (src/scripts/hero-word.ts). All the words sit in one
 * inline grid cell, so the slot is always as wide as the longest word and nothing moves. Screen
 * readers get the plain sentence (home.json → hero.headline); the animated copy is aria-hidden.
 * Reduced motion and no JavaScript: the last word only, static.
 */
import Media from './Media.astro';
import home from '../content/home.json';

const { hero } = home;
const words = hero.rotatingWords;
if (`${hero.headlineLead} ${words.at(-1)}` !== hero.headline) {
  throw new Error('home.json → hero: headline must be headlineLead + the last rotating word (it is what screen readers hear).');
}
---

<section class="hero wrap pt-10 pb-12 md:pt-16 lg:pt-20 lg:pb-16" aria-labelledby="hero-heading">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="hero-intro lg:col-span-7">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-heading" class="mt-5 text-display-xl">
        <span class="sr-only">{hero.headline}</span><span aria-hidden="true"
          >{hero.headlineLead}{' '}<span class="hero-rot" data-hero-rot
            >{words.map((w, i) => <span class:list={['hero-word', i === words.length - 1 && 'is-last']}>{w}</span>)}</span
          ></span
        >
      </h1>
      <p class="lead mt-6 max-w-xl">{hero.subline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn btn-secondary">{hero.secondary.label}</a>
      </div>
      <p class="mt-6 flex items-center gap-2.5 text-sm text-fg-muted">
        <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {hero.roleLine}
      </p>
    </div>
    <div class="lg:col-span-5">
      <Media
        image={hero.image}
        eager
        position={hero.imagePosition}
        sizes="(min-width: 1024px) 760px, 100vw"
        class="aspect-[3/2] rounded-card sm:aspect-[16/10] lg:aspect-[4/5]"
      />
    </div>
  </div>
</section>

<script>
  import { initHeroWord } from '../scripts/hero-word';
  initHeroWord();
</script>

<style>
  /* One grid cell for every word: the slot is as wide as the longest, so the line never reflows. */
  .hero-rot {
    display: inline-grid;
    justify-items: start;
  }
  .hero-word {
    grid-area: 1 / 1;
    /* The gradient is clipped to the box: give the glyphs room above and below (the display line height
       is under 1), and take it back with negative margins so the line box stays exactly the same. */
    padding-block: 0.15em;
    margin-block: -0.15em;
    background-image: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    visibility: hidden;
  }
  /* Static (no JavaScript, reduced motion): the last word only */
  .hero-word.is-last {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* With JavaScript: only the word on stage shows. The pass starts on the first word, already on
       screen at the first paint. */
    :global(html.js) .hero-rot .hero-word {
      opacity: 0;
      visibility: hidden;
    }
    :global(html.js) .hero-rot:not([data-at]) .hero-word:first-child {
      opacity: 1;
      visibility: visible;
    }
    /* Waiting below: an incoming word rises from 0.35em below and sharpens from blur(4px) */
    :global(html.js) .hero-rot[data-at] .hero-word {
      transform: translateY(0.35em);
      filter: blur(4px);
    }
    :global(html.js) .hero-rot[data-at] .hero-word.is-in {
      opacity: 1;
      visibility: visible;
      transform: none;
      filter: blur(0);
      transition:
        opacity 450ms var(--ease-reveal),
        transform 450ms var(--ease-reveal),
        filter 450ms var(--ease-reveal);
    }
    /* The outgoing word moves up 0.35em and fades out */
    :global(html.js) .hero-rot[data-at] .hero-word.is-out {
      visibility: visible;
      opacity: 0;
      transform: translateY(-0.35em);
      filter: none;
      transition:
        opacity 450ms var(--ease-reveal),
        transform 450ms var(--ease-reveal);
    }
  }
</style>
