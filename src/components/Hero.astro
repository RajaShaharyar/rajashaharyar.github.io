---
/**
 * Homepage section 1: who he is in one look.
 * The headline's last word rotates once ("traction." → "businesses." → "revenue.", home.json →
 * hero.rotatingWords) and stops on the last one (src/scripts/hero-word.ts). All the words sit in one
 * inline grid cell, so the slot is always as wide as the longest word and nothing moves. Screen
 * readers get the plain sentence (home.json → hero.headline); the animated copy is aria-hidden.
 * Reduced motion and no JavaScript: the last word only, static.
 *
 * The portrait (Phase 19): Raja's black and white cutout (portrait 2, the LCP element: preloaded by
 * index.astro, eager, fetchpriority high, srcset and sizes, width and height). From 1024 px it stands in the
 * left column on the hero's bottom edge, its flat desk line flush with it, about 85% of the hero's height,
 * looking towards the headline on the right. Behind him: a violet disc behind his head and the giant outlined
 * word (home.json → hero.giantWord, aria-hidden) across the lower part of the hero, below the H1. Phones: the
 * text first, then the portrait at full width on the hero's bottom edge, the word smaller behind it.
 * Scroll (scrubbed, reversible; src/scripts/hero-scroll.ts): the word drifts left by up to 20vw, the portrait
 * sinks by up to 40px (rising slower than the page), the disc scales up to 1.06. Static with reduced motion.
 * The band: near-black with a slow aurora and a fine grain (Aurora.astro); the rotating word uses the brand
 * gradient.
 */
import Aurora from './Aurora.astro';
import home from '../content/home.json';
import { heroPortrait } from '../lib/portraits';
// The giant word as outline paths in the display font (tools/portraits/giant_word.py), not SVG text: text this
// big would become the Largest Contentful Paint element, and the portrait must be.
import giant from '../lib/giant-word.json';

const { hero } = home;
const words = hero.rotatingWords;
if (`${hero.headlineLead} ${words.at(-1)}` !== hero.headline) {
  throw new Error('home.json → hero: headline must be headlineLead + the last rotating word (it is what screen readers hear).');
}
const portrait = heroPortrait(hero.portrait);
if (giant.word !== hero.giantWord) throw new Error('home.json → hero.giantWord changed: run python tools/portraits/giant_word.py <word>.');
const giantBox = `-4 ${-(giant.capHeight + 4)} ${giant.width + 8} ${giant.capHeight + 8}`;
---

<section class="hero band" aria-labelledby="hero-heading" data-hero>
  <Aurora variant="drift" id="grain-hero" />
  <svg class="hero-giant" viewBox={giantBox} aria-hidden="true" focusable="false" data-hero-giant>
    <path d={giant.d}></path>
  </svg>
  <div class="wrap hero-grid">
    <div class="hero-intro">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-heading" class="hero-title mt-5">
        <span class="sr-only">{hero.headline}</span><span aria-hidden="true"
          >{hero.headlineLead}{' '}<span class="hero-rot" data-hero-rot
            >{words.map((w, i) => <span class:list={['hero-word', i === words.length - 1 && 'is-last']}>{w}</span>)}</span
          ></span
        >
      </h1>
      <p class="lead mt-6 max-w-xl">{hero.subline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn btn-secondary">{hero.secondary.label}</a>
      </div>
      <p class="mt-6 flex items-center gap-2.5 text-sm text-fg-muted">
        <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {hero.roleLine}
      </p>
    </div>
    <div class="hero-figure">
      <span class="hero-disc" aria-hidden="true" data-hero-disc></span>
      <img
        class="hero-portrait"
        src={portrait.src}
        srcset={portrait.srcset}
        sizes={portrait.sizes}
        width={portrait.width}
        height={portrait.height}
        alt={portrait.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-hero-portrait
      />
    </div>
  </div>
</section>

<script>
  import { initHeroWord } from '../scripts/hero-word';
  import { initHeroScroll } from '../scripts/hero-scroll';
  initHeroWord();
  initHeroScroll();
</script>

<style>
  .hero {
    --portrait-ratio: 1600 / 1777;
    overflow: clip; /* the drifting word and the sinking portrait never widen or lengthen the page */
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    padding-top: 2.5rem;
  }
  .hero-intro {
    position: relative;
    z-index: 2;
  }
  .hero-title {
    font-size: var(--text-display-xl);
    line-height: var(--text-display-xl--line-height);
    letter-spacing: var(--text-display-xl--letter-spacing);
  }

  /* The portrait: phones and tablets, at full width under the text, standing on the hero's bottom edge */
  .hero-figure {
    position: relative;
    z-index: 1;
    width: min(100%, 34rem);
    justify-self: center;
    aspect-ratio: var(--portrait-ratio);
  }
  .hero-portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  /* A violet disc up and behind his head (his head sits at about 52% across, 20% down) */
  .hero-disc {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 68%;
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--color-accent-2);
    translate: -50% -50%;
  }
  /* The giant outlined word, low across the hero, behind the portrait (never behind the H1) */
  .hero-giant {
    position: absolute;
    left: -2vw;
    bottom: 3%;
    z-index: 0;
    width: 135vw;
    height: auto;
    overflow: visible;
    pointer-events: none;
    user-select: none;
  }
  .hero-giant path {
    fill: none;
    stroke: var(--color-accent-2-strong);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    opacity: 0.32;
  }
  @media (width < 64rem) {
    .hero-intro {
      padding-bottom: 0.5rem;
    }
    .hero-giant {
      width: 110vw;
      bottom: 4%;
    }
  }

  /* From 1024 px: the portrait in the left column, the text on the right; the hero is about a screen tall and
     the portrait 85% of it, standing on the bottom edge */
  @media (width >= 64rem) {
    .hero {
      --hero-h: clamp(34rem, calc(100svh - 7.5rem), 46rem);
      min-height: var(--hero-h);
      display: grid;
    }
    .hero-grid {
      grid-template-columns: min(calc(var(--hero-h) * 0.85 * 1600 / 1777), 52%) minmax(0, 1fr);
      column-gap: 3rem;
      align-items: end;
      padding-top: 3rem;
    }
    .hero-intro {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      padding-bottom: 3rem;
    }
    .hero-title {
      font-size: clamp(2.75rem, 4.7vw, 4.75rem);
    }
    .hero-figure {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      height: calc(var(--hero-h) * 0.85);
      aspect-ratio: auto;
      justify-self: stretch;
      align-self: end;
    }
    .hero-giant {
      width: 130vw;
      bottom: 4%;
    }
  }

  /* One grid cell for every word: the slot is as wide as the longest, so the line never reflows. */
  .hero-rot {
    display: inline-grid;
    justify-items: start;
  }
  .hero-word {
    grid-area: 1 / 1;
    /* The gradient is clipped to the box: give the glyphs room above and below (the display line height
       is under 1), and take it back with negative margins so the line box stays exactly the same. */
    padding-block: 0.15em;
    margin-block: -0.15em;
    background-image: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    visibility: hidden;
  }
  /* Static (no JavaScript, reduced motion): the last word only */
  .hero-word.is-last {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* With JavaScript: only the word on stage shows. The pass starts on the first word, already on
       screen at the first paint. */
    :global(html.js) .hero-rot .hero-word {
      opacity: 0;
      visibility: hidden;
    }
    :global(html.js) .hero-rot:not([data-at]) .hero-word:first-child {
      opacity: 1;
      visibility: visible;
    }
    /* Waiting below: an incoming word rises from 0.35em below and sharpens from blur(4px) */
    :global(html.js) .hero-rot[data-at] .hero-word {
      transform: translateY(0.35em);
      filter: blur(4px);
    }
    :global(html.js) .hero-rot[data-at] .hero-word.is-in {
      opacity: 1;
      visibility: visible;
      transform: none;
      filter: blur(0);
      transition:
        opacity 450ms var(--ease-reveal),
        transform 450ms var(--ease-reveal),
        filter 450ms var(--ease-reveal);
    }
    /* The outgoing word moves up 0.35em and fades out */
    :global(html.js) .hero-rot[data-at] .hero-word.is-out {
      visibility: visible;
      opacity: 0;
      transform: translateY(-0.35em);
      filter: none;
      transition:
        opacity 450ms var(--ease-reveal),
        transform 450ms var(--ease-reveal);
    }
  }
</style>
