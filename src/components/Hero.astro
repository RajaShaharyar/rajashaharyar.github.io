---
/** Homepage section 1: who he is in one look. */
import Media from './Media.astro';
import home from '../content/home.json';
import { site } from '../lib/site';
import { publicFileExists } from '../lib/public-files';

const { hero } = home;
// "Download CV" appears only once public/cv.pdf exists.
const showCv = publicFileExists(site.cv.pdfHref);
---

<section class="wrap pt-10 pb-12 md:pt-16 lg:pt-20 lg:pb-16" aria-labelledby="hero-heading">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-heading" class="mt-5 text-display-xl">{hero.headline}</h1>
      <p class="lead mt-6 max-w-xl">{hero.subline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn btn-secondary">{hero.secondary.label}</a>
        {
          showCv && (
            <a href={site.cv.pdfHref} class="btn btn-secondary" download>
              {hero.cvButton.label}
            </a>
          )
        }
      </div>
      <p class="mt-6 flex items-center gap-2.5 text-sm text-fg-muted">
        <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {hero.roleLine}
      </p>
    </div>
    <div class="lg:col-span-5">
      <Media
        image={hero.image}
        eager
        position={hero.imagePosition}
        class="aspect-[3/2] rounded-card sm:aspect-[16/10] lg:aspect-[4/5]"
      />
    </div>
  </div>
</section>
