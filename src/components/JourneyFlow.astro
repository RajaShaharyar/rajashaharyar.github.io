---
/**
 * A customer journey as accessible HTML: an ordered list styled as a flow
 * (horizontal on desktop, vertical on phones). Each step shows its owner;
 * accent steps (e.g. the State Bank review) take the accent colour. A
 * "Goes live with" row of chips follows. No images of text.
 */
interface Step {
  label: string;
  owner: string;
  accent?: boolean;
}

interface Props {
  /** Accessible name for the list of steps */
  label: string;
  steps: Step[];
  goesLiveWith?: string[];
  caption?: string;
}

const { label, steps, goesLiveWith = [], caption } = Astro.props;
---

<div class="journey">
  <ol class="journey-steps" aria-label={label}>
    {
      steps.map((step, i) => (
        <li class="journey-step" data-accent={step.accent || undefined}>
          <span class="journey-num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="journey-label">{step.label}</span>
          <span class="journey-owner">
            <span class="sr-only">Owner: </span>
            {step.owner}
          </span>
        </li>
      ))
    }
  </ol>
  {
    goesLiveWith.length > 0 && (
      <div class="journey-live">
        <p class="journey-live-label">Goes live with</p>
        <ul class="flex flex-wrap gap-2">
          {goesLiveWith.map((item) => (
            <li class="chip">{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  {caption && <p class="journey-caption">{caption}</p>}
</div>

<style>
  .journey-steps {
    display: grid;
    gap: 1.75rem;
    counter-reset: none;
  }
  .journey-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    align-items: baseline;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }
  /* Connector on phones: a short line down to the next step */
  .journey-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 2.25rem;
    bottom: -1.75rem;
    width: 2px;
    height: 1.75rem;
    background-color: var(--color-line-strong);
  }
  .journey-num {
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-fg-subtle);
  }
  .journey-label {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-fg);
  }
  .journey-owner {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
  .journey-step[data-accent] {
    border-color: var(--color-accent);
    background-color: color-mix(in srgb, var(--color-accent) 9%, var(--color-surface));
  }
  .journey-step[data-accent] .journey-num,
  .journey-step[data-accent] .journey-owner {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Desktop: one row, with an arrow between steps */
  @media (width >= 64rem) {
    .journey-steps {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .journey-step {
      grid-template-columns: 1fr;
      align-content: start;
      row-gap: 0.5rem;
      padding: 1.125rem;
    }
    .journey-num {
      grid-row: auto;
    }
    .journey-step:not(:last-child)::after {
      content: '→';
      left: auto;
      right: -1.6rem;
      top: 50%;
      bottom: auto;
      width: auto;
      height: auto;
      transform: translateY(-50%);
      background: none;
      color: var(--color-line-strong);
      font-size: 1.125rem;
      line-height: 1;
    }
  }

  .journey-live {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 1.75rem;
  }
  .journey-live-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .journey-caption {
    margin-top: 1.25rem;
    max-width: var(--container-prose);
    color: var(--color-fg-muted);
  }
</style>
