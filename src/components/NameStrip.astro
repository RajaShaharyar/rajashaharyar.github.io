---
/** Homepage credibility strip: names as plain text (no logos until permission is clear), with violet separators. */
interface Props {
  /** id of the heading, for the section's aria-labelledby */
  id?: string;
  title: string;
  names: string[];
}

const { id, title, names } = Astro.props;
---

<div>
  <h2 id={id} class="font-sans text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">{title}</h2>
  <ul class="names mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    {names.map((name) => <li class="font-display text-lg font-semibold text-fg-muted sm:text-xl">{name}</li>)}
  </ul>
</div>

<style>
  .names li {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }
  .names li + li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background-color: var(--color-accent-2-strong);
  }
</style>
