---
/**
 * One offer. variant="summary" (homepage "How I can help"): title and its
 * one-line summary. variant="full" (Work With Me): for whom, what they get,
 * and a proof line linking to the venture section that backs it.
 * Phase 18: a raised dark card on near-black, with a lime index number and a lime top edge, the
 * spotlight and gradient border, and an optional lime button (button prop: the homepage cards).
 */
import ArrowLink from './ArrowLink.astro';
import type { Offer } from '../lib/site';

interface Props {
  offer: Offer;
  index: number;
  variant?: 'summary' | 'full';
  /** A lime button at the foot of the card */
  button?: { label: string; href: string };
}

const { offer, index, variant = 'summary', button } = Astro.props;
---

<article class="offer flex h-full flex-col gap-4 rounded-card border border-line bg-surface p-6 md:p-8" data-spotlight>
  <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  <h3 class="text-2xl md:text-[1.75rem]">{offer.title}</h3>
  {
    variant === 'summary' ? (
      <>
        <p class="text-fg-muted">{offer.summary ?? `${offer.forWhom}: ${offer.gets}`}</p>
        {button && (
          <a href={button.href} class="btn btn-primary mt-auto self-start">
            {button.label}
            <span class="sr-only">: {offer.title}</span>
          </a>
        )}
      </>
    ) : (
      <>
        <p class="font-semibold text-fg">{offer.forWhom}</p>
        <p class="text-fg-muted">{offer.gets}</p>
        <div class="mt-auto border-t border-line pt-5">
          <p class="text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">Proof</p>
          <ArrowLink href={offer.proof.href} class="mt-2">
            {offer.proof.label}
          </ArrowLink>
        </div>
      </>
    )
  }
</article>

<style>
  /* A lime top edge: the card's own 2 px border, so the radius carries it */
  .offer {
    border-top: 2px solid var(--color-accent);
  }
</style>
