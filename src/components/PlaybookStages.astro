---
/**
 * Homepage methodologies: Idea → Fit → Scale. Each card: the question it
 * answers, "How I do it" (the matching principles, worded exactly as in Work
 * With Me → How I work) and "Seen at" links into the venture pages.
 * Copy: home.json → playbook (the principles are checked against work-with-me.json).
 */
import ArrowLink from './ArrowLink.astro';
import home from '../content/home.json';
import workWithMe from '../content/work-with-me.json';

interface Stage {
  id: string;
  name: string;
  question: string;
  principles: string[];
  seenAt: { label: string; href: string }[];
}

interface Props {
  stages: Stage[];
}

const known = new Set(workWithMe.howIWork.items.map((i) => i.principle));
for (const s of Astro.props.stages) {
  for (const p of s.principles) {
    if (!known.has(p)) throw new Error(`home.json → playbook: "${p}" is not a principle in work-with-me.json → howIWork.`);
  }
}
const { howLabel, seenAtLabel } = home.playbook;

const { stages } = Astro.props;
---

<ol class="stages grid gap-4 lg:grid-cols-3 lg:gap-8" data-reveal-stagger>
  {
    stages.map((stage, i) => (
      <li class="stage flex flex-col rounded-card border border-line bg-surface p-6 md:p-8" id={`stage-${stage.id}`}>
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="text-lg font-semibold tracking-tight">{stage.name}</h3>
        </div>
        <p class="mt-5 font-display text-2xl leading-tight font-semibold tracking-tight md:text-[1.75rem]">
          {stage.question}
        </p>
        <div class="min-h-8 flex-1" aria-hidden="true" />
        <div class="border-t border-line pt-5">
          <p class="text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">{howLabel}</p>
          <ul class="mt-2 flex flex-col gap-1">
            {stage.principles.map((p) => (
              <li class="font-medium text-fg">{p}</li>
            ))}
          </ul>
          <p class="mt-4 text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">{seenAtLabel}</p>
          <ul class="flex flex-wrap gap-x-5">
            {stage.seenAt.map((link) => (
              <li>
                <ArrowLink href={link.href}>{link.label}</ArrowLink>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* Arrow between stages on wide screens: Idea → Fit → Scale */
  @media (width >= 64rem) {
    .stage {
      position: relative;
    }
    .stage:not(:last-child)::after {
      content: '→';
      position: absolute;
      top: 2.1rem;
      right: -1.6rem;
      color: var(--color-accent);
      font-size: 1.25rem;
      line-height: 1;
    }
  }
</style>
