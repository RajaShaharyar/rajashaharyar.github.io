---
/**
 * One small schematic drawing per product (homepage #products). Decorative:
 * the wrapper is aria-hidden, nothing inside is focusable, and there are no
 * words, numbers, names, logos or real-looking data in the drawings.
 * Colours are the site tokens. The default state of every element IS the
 * final frame; ProductShowcase's script "arms" a drawing (paused at its first
 * frame) and plays it once. Without JavaScript or with reduced motion, the
 * final frame simply shows.
 *
 * Steps: class "k" plus one of k-fade, k-up (rises 12px), k-down (drops 14px),
 * k-left (moves 24px right into place), k-pop (grows from 60%), with its delay
 * in --d. Each drawing finishes within 1.6 s.
 */
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<svg class="art-svg" viewBox="0 0 320 220" width="320" height="220" aria-hidden="true" focusable="false">
  {
    id === 'dressup' && (
      <>
        {/* A search bar (placeholder bar, no words) */}
        <g class="k k-up" style="--d:0ms">
          <rect class="f-raised s-strong" x="40" y="24" width="240" height="36" rx="18" />
          <circle class="s-muted" cx="62" cy="41" r="7" fill="none" stroke-width="2.5" />
          <path class="s-muted" d="M67 46l5 5" stroke-width="2.5" stroke-linecap="round" />
          <rect class="f-line" x="82" y="38" width="112" height="7" rx="3.5" />
        </g>
        {/* Result tiles appear */}
        {[
          [40, 78, 250],
          [126, 78, 330],
          [212, 78, 410],
          [40, 146, 490],
          [126, 146, 570],
          [212, 146, 650],
        ].map(([x, y, d]) => (
          <g class="k k-up" style={`--d:${d}ms`}>
            <rect class="f-raised s-line" x={x} y={y} width="68" height="60" rx="10" />
            <rect class="f-line" x={x + 10} y={y + 10} width="48" height="26" rx="6" />
            <rect class="f-line" x={x + 10} y={y + 44} width="30" height="6" rx="3" />
          </g>
        ))}
        {/* One tile is picked out for the brand: personalised search */}
        <rect class="k k-pop s-accent" style="--d:1000ms" x="122" y="142" width="76" height="68" rx="13" fill="none" stroke-width="2.5" />
        <g class="k k-pop" style="--d:1200ms">
          <circle class="f-accent" cx="196" cy="146" r="10" />
          <path class="s-ink" d="M191.5 146l3 3 6-6.5" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </>
    )
  }
  {
    id === 'asaanbill' && (
      <>
        {/* An invoice */}
        <g class="k k-up" style="--d:0ms">
          <rect class="f-raised s-strong" x="54" y="18" width="128" height="184" rx="12" />
          <rect class="f-strong" x="70" y="36" width="58" height="10" rx="5" />
          <rect class="f-line" x="70" y="62" width="96" height="6" rx="3" />
          <rect class="f-line" x="70" y="76" width="78" height="6" rx="3" />
          <rect class="f-line" x="70" y="90" width="88" height="6" rx="3" />
          <rect class="f-line" x="70" y="116" width="96" height="1.5" />
          <rect class="f-strong" x="118" y="128" width="48" height="10" rx="5" />
        </g>
        {/* Three ways to pay (PSID, QR, Request to Pay), as icon chips */}
        <g class="k k-fade" style="--d:200ms">
          <rect class="f-surface s-strong" x="206" y="46" width="84" height="32" rx="16" />
          <rect class="f-surface s-strong" x="206" y="94" width="84" height="32" rx="16" />
          <rect class="f-surface s-strong" x="206" y="142" width="84" height="32" rx="16" />
          <g class="f-muted">
            <rect x="236" y="53" width="2.5" height="18" />
            <rect x="241" y="53" width="1.5" height="18" />
            <rect x="245" y="53" width="3" height="18" />
            <rect x="251" y="53" width="1.5" height="18" />
            <rect x="255" y="53" width="2.5" height="18" />
            <rect x="238" y="101" width="8" height="8" rx="1" />
            <rect x="250" y="101" width="8" height="8" rx="1" />
            <rect x="238" y="113" width="8" height="8" rx="1" />
            <rect x="251" y="114" width="6" height="6" rx="1" />
          </g>
          <path class="s-muted" d="M238 158h18m-6-6l6 6-6 6" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        {/* ...light up in turn */}
        {[
          [46, 450],
          [94, 650],
          [142, 850],
        ].map(([y, d], i) => (
          <g class="k k-fade" style={`--d:${d}ms`}>
            <rect class="f-accent" x="206" y={y} width="84" height="32" rx="16" />
            {i === 0 && (
              <g class="f-ink">
                <rect x="236" y="53" width="2.5" height="18" />
                <rect x="241" y="53" width="1.5" height="18" />
                <rect x="245" y="53" width="3" height="18" />
                <rect x="251" y="53" width="1.5" height="18" />
                <rect x="255" y="53" width="2.5" height="18" />
              </g>
            )}
            {i === 1 && (
              <g class="f-ink">
                <rect x="238" y="101" width="8" height="8" rx="1" />
                <rect x="250" y="101" width="8" height="8" rx="1" />
                <rect x="238" y="113" width="8" height="8" rx="1" />
                <rect x="251" y="114" width="6" height="6" rx="1" />
              </g>
            )}
            {i === 2 && <path class="s-ink" d="M238 158h18m-6-6l6 6-6 6" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
          </g>
        ))}
        {/* Paid */}
        <g class="k k-pop" style="--d:1150ms">
          <circle class="f-accent" cx="170" cy="178" r="20" />
          <path class="s-ink" d="M161 178l6.5 6.5L180 171" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </>
    )
  }
  {
    id === 'sonicengine-ai' && (
      <>
        {/* A prompt (grey bars, no words) */}
        <g class="k k-up" style="--d:0ms">
          <rect class="f-raised s-strong" x="30" y="18" width="260" height="34" rx="9" />
          <rect class="f-strong" x="44" y="31" width="70" height="8" rx="4" />
          <rect class="f-strong" x="120" y="31" width="48" height="8" rx="4" />
          <rect class="f-strong" x="174" y="31" width="84" height="8" rx="4" />
          <rect class="f-accent" x="266" y="27" width="3" height="16" rx="1.5" />
        </g>
        {/* ...becomes a game scene, block by block */}
        <rect class="k k-fade s-line" style="--d:250ms" x="30" y="64" width="260" height="140" rx="10" fill="none" stroke-width="2" />
        {[50, 90, 130, 170, 210, 250].map((x, i) => (
          <rect class="k k-down f-raised s-strong" style={`--d:${350 + i * 50}ms`} x={x - 10} y="176" width="40" height="20" rx="3" />
        ))}
        <rect class="k k-down f-raised s-strong" style="--d:700ms" x="180" y="132" width="40" height="18" rx="3" />
        <rect class="k k-down f-raised s-strong" style="--d:750ms" x="220" y="132" width="40" height="18" rx="3" />
        <rect class="k k-pop f-accent" style="--d:850ms" x="66" y="148" width="20" height="28" rx="5" />
        <circle class="k k-pop s-accent" style="--d:950ms" cx="240" cy="112" r="8" fill="none" stroke-width="3" />
        {/* Play */}
        <g class="k k-pop" style="--d:1150ms">
          <circle class="f-accent" cx="148" cy="118" r="22" />
          <path class="f-ink" d="M141 107v22l18-11z" />
        </g>
      </>
    )
  }
  {
    id === 'tapit' && (
      <>
        {/* A phone */}
        <g class="k k-fade" style="--d:0ms">
          <rect class="f-raised s-strong" x="184" y="14" width="104" height="192" rx="18" />
          <rect class="f-bg" x="194" y="32" width="84" height="156" rx="9" />
          <rect class="f-strong" x="222" y="21" width="28" height="4" rx="2" />
        </g>
        {/* A card moves toward it */}
        <g class="k k-left" style="--d:250ms">
          <rect class="f-accent" x="56" y="78" width="100" height="62" rx="9" />
          <rect class="f-ink-soft" x="68" y="92" width="22" height="16" rx="3" />
          <rect class="f-ink-soft" x="68" y="120" width="44" height="6" rx="3" />
          <path class="s-ink" d="M132 98a10 10 0 0 1 0 14M138 93a17 17 0 0 1 0 24" fill="none" stroke-width="2.5" stroke-linecap="round" />
        </g>
        {/* Tap */}
        <path class="k k-fade s-accent" style="--d:650ms" d="M165 98a14 14 0 0 1 0 22M171 92a22 22 0 0 1 0 34" fill="none" stroke-width="2.5" stroke-linecap="round" />
        {/* A contact card rises on the screen (placeholder lines) */}
        <g class="k k-up" style="--d:850ms">
          <rect class="f-surface s-line" x="202" y="100" width="68" height="78" rx="9" />
          <circle class="f-strong" cx="218" cy="118" r="8" />
          <rect class="f-line" x="232" y="112" width="28" height="5" rx="2.5" />
          <rect class="f-line" x="232" y="121" width="20" height="5" rx="2.5" />
          <rect class="f-line" x="210" y="138" width="52" height="5" rx="2.5" />
          <rect class="f-line" x="210" y="148" width="38" height="5" rx="2.5" />
        </g>
        <rect class="k k-fade f-accent" style="--d:1150ms" x="210" y="160" width="52" height="10" rx="5" />
      </>
    )
  }
  {
    id === 'ladenza' && (
      <>
        {/* A clothes tag */}
        <g class="k k-up" style="--d:0ms">
          <path class="f-raised s-strong" d="M44 92l14-16h40a6 6 0 0 1 6 6v60a6 6 0 0 1-6 6H50a6 6 0 0 1-6-6z" stroke-width="2" stroke-linejoin="round" />
          <circle class="f-bg s-strong" cx="60" cy="92" r="5" />
          <path class="s-muted" d="M60 87c-6-14-18-16-26-12" fill="none" stroke-width="2" stroke-linecap="round" />
          <rect class="f-line" x="70" y="104" width="26" height="6" rx="3" />
          <rect class="f-line" x="70" y="116" width="20" height="6" rx="3" />
          <rect class="f-accent" x="70" y="130" width="26" height="8" rx="4" />
        </g>
        <path class="k k-fade s-strong" style="--d:350ms" d="M112 112h14" fill="none" stroke-width="2.5" stroke-dasharray="3 5" stroke-linecap="round" />
        {/* ...a parcel */}
        <g class="k k-up" style="--d:450ms">
          <rect class="f-raised s-strong" x="134" y="84" width="64" height="58" rx="6" />
          <path class="s-strong" d="M134 100h64" fill="none" stroke-width="2" />
          <rect class="f-accent" x="160" y="84" width="12" height="58" />
        </g>
        <path class="k k-fade s-strong" style="--d:750ms" d="M206 112h14" fill="none" stroke-width="2.5" stroke-dasharray="3 5" stroke-linecap="round" />
        {/* ...a hostel building */}
        <g class="k k-up" style="--d:850ms">
          <path class="f-raised s-strong" d="M228 74l32-22 32 22v114h-64z" stroke-width="2" stroke-linejoin="round" />
          {[
            [240, 86],
            [266, 86],
            [240, 112],
            [266, 112],
            [240, 138],
            [266, 138],
          ].map(([x, y]) => (
            <rect class="f-line" x={x} y={y} width="16" height="14" rx="2" />
          ))}
          <rect class="f-strong" x="252" y="164" width="16" height="24" rx="2" />
        </g>
        {/* Delivered */}
        <g class="k k-pop" style="--d:1200ms">
          <circle class="f-accent" cx="290" cy="56" r="16" />
          <path class="s-ink" d="M283 56l5 5 9-10" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </>
    )
  }
</svg>

<style>
  .art-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .art-svg :global(.k) {
    transform-box: fill-box;
    transform-origin: center;
  }
  .art-svg .f-raised {
    fill: var(--color-raised);
  }
  .art-svg .f-surface {
    fill: var(--color-surface);
  }
  .art-svg .f-bg {
    fill: var(--color-bg);
  }
  .art-svg .f-line {
    fill: var(--color-line);
  }
  .art-svg .f-strong {
    fill: var(--color-line-strong);
  }
  .art-svg .f-muted {
    fill: var(--color-fg-subtle);
  }
  .art-svg .f-accent {
    fill: var(--color-accent);
  }
  .art-svg .f-ink {
    fill: var(--color-accent-ink);
  }
  .art-svg .f-ink-soft {
    fill: color-mix(in srgb, var(--color-accent-ink) 30%, transparent);
  }
  .art-svg .s-strong {
    stroke: var(--color-line-strong);
    stroke-width: 2;
  }
  .art-svg .s-line {
    stroke: var(--color-line);
    stroke-width: 2;
  }
  .art-svg .s-muted {
    stroke: var(--color-fg-subtle);
  }
  .art-svg .s-accent {
    stroke: var(--color-accent);
  }
  .art-svg .s-ink {
    stroke: var(--color-accent-ink);
  }
</style>
