          <rect class="a gx f-strong" x="188" y="76" width="58" height="10" rx="5" style={T(1, 260, 250)} />
          <rect class="a gx f-line" x="188" y="104" width="104" height="7" rx="3.5" style={T(1, 340, 250)} />
          <rect class="a gx f-line" x="188" y="122" width="88" height="7" rx="3.5" style={T(1, 420, 250)} />
