---
/**
 * One short brand story per product (homepage #products; the compact two also
 * fill the photo slot of their /ventures cards). Each scene shows what the
 * product does in 4 beats; the accent marks Raja's part.
 *
 * How it is wired
 * - The beat start times come from home.json → products.items[].steps[].at and
 *   are set on the root as --b1…--b4. Every animated element has class "a", an
 *   animation class (fade, up, draw, pop, …) and its start as
 *   --t: calc(var(--bN) + offset), with an optional duration --d. The step list
 *   (ProductSteps) uses the same beat starts, so drawing and list stay in sync.
 * - The default (unanimated) state of every element IS the final frame: that is
 *   what visitors without JavaScript or with reduced motion see.
 * - The deck's script (deck.ts) only sets data-armed (paused on the first frame) and
 *   data-playing (run). Restarting = removing both, reflow, setting both again.
 * - Only transform, opacity and stroke-dashoffset animate. Travel stays within
 *   ~50 viewBox units (one hand-off per scene: ~100), rotation within 8°, one
 *   overshoot to 1.08. No words, numbers or logos in the drawings.
 * - Featured scenes (AsaanBill, TapitCard, Ladenza) use a 480×360 viewBox; the
 *   compact ones (Sonic AI Engine, DressUp AI) 320×220.
 */
import home from '../content/home.json';

interface Props {
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
const story = home.products.items.find((p) => p.id === id);
if (!story) throw new Error(`ProductScene: no home.json → products.items entry for "${id}".`);
const compact = id === 'sonicengine-ai' || id === 'dressup';
const [w, h] = compact ? [320, 220] : [480, 360];
const beats = story.steps.map((s, i) => `--b${i + 1}:${s.at}ms`).join(';');
/** Start time (beat + offset) and optional duration, as inline custom properties */
const T = (beat: number, offset = 0, dur?: number) => `--t:calc(var(--b${beat}) + ${offset}ms)${dur ? `;--d:${dur}ms` : ''}`;
---

