---
/**
 * "How it works": a product's 4 steps as a real ordered list (read once by
 * screen readers; no aria-live). Raja's steps carry a small accent dot (and
 * "(my part)" for screen readers), with a one-line key under the list.
 *
 * Sync with the drawing: each step's --t is its beat start and --len the time
 * until the next beat (home.json → products.items[].steps[].at). When the
 * script plays the scene it sets the same data-armed / data-playing on this
 * list, so a step lights up (accent marker, full-contrast text) as its beat
 * starts and earlier steps stay checked. Before playing, every step shows as
 * complete; so it does with reduced motion or without JavaScript.
 */
interface Step {
  text: string;
  at: number;
  mine: boolean;
  len: number;
}
interface Props {
  id: string;
  steps: Step[];
  heading: string;
  keyLabel: string;
}
const { id, steps, heading, keyLabel } = Astro.props;
const headingId = `${id}-steps`;
---

<div class="how">
  <p class="how-label" id={headingId}>{heading}</p>
  <ol class="steps" data-steps={id} aria-labelledby={headingId}>
    {
      steps.map((s) => (
        <li class="step" style={`--t:${s.at}ms;--len:${s.len}ms`}>
          <span class="mark" aria-hidden="true">
            <svg class="mark-on" viewBox="0 0 16 16" width="16" height="16">
              <circle cx="8" cy="8" r="8" />
              <path d="M4.5 8.2l2.3 2.3 4.7-5" />
            </svg>
          </span>
          <span class="step-text">
            {s.text}
            {s.mine && <span class="sr-only"> (my part)</span>}
          </span>
          {s.mine && <span class="mine" aria-hidden="true" />}
        </li>
      ))
    }
  </ol>
  {
    steps.some((s) => s.mine) && (
      <p class="how-key">
        <span class="mine" aria-hidden="true" />
        {keyLabel}
      </p>
    )
  }
</div>

<style>
  .how-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .steps {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.125rem 0.5rem 0.125rem 0.25rem;
    margin-left: -0.25rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-fg);
  }
  /* The current step's highlight: only visible while its beat runs */
  .step::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    background-color: var(--color-raised);
    opacity: 0;
    z-index: -1;
  }
  .steps {
    isolation: isolate;
  }
  .mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-line-strong);
    border-radius: 999px;
  }
  .mark-on {
    position: absolute;
    inset: -2px;
    width: 1rem;
    height: 1rem;
  }
  .mark-on circle {
    fill: var(--color-accent);
  }
  .mark-on path {
    fill: none;
    stroke: var(--color-accent-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mine {
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 999px;
    background-color: var(--color-accent);
  }
  .how-key {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
  }

  /* Playing: set by ProductShowcase's script together with the scene */
  @media (prefers-reduced-motion: no-preference) {
    .steps[data-armed] .mark-on {
      animation: step-on 180ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--t) both paused;
    }
    .steps[data-armed] .step-text {
      animation: step-text 180ms linear var(--t) both paused;
    }
    .steps[data-armed] .step::before {
      animation: step-current var(--len) linear var(--t) paused;
    }
    .steps[data-armed][data-playing] .mark-on,
    .steps[data-armed][data-playing] .step-text,
    .steps[data-armed][data-playing] .step::before {
      animation-play-state: running;
    }
  }
  @keyframes step-on {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @keyframes step-text {
    from {
      opacity: 0.62;
    }
  }
  @keyframes step-current {
    from,
    to {
      opacity: 1;
    }
  }
</style>
