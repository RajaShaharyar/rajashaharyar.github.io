---
/**
 * "How it works": a product's 4 steps as a real ordered list (read once by screen readers; no
 * aria-live). Raja's steps have a lime tick and a small outlined "My part" tag right after the
 * step text, inside the same list item so it wraps with the text; screen readers hear
 * "(my part)" instead of the tag. Other steps get a neutral tick. Lime means "my part" only.
 *
 * Deck-synced (sync="state", driven by deck.ts): each step is done, active or upcoming with its
 * card's animation (data-state; beats from data-at). Without data-state (no JavaScript, reduced
 * motion) every step shows complete.
 */
interface Step {
  text: string;
  at: number;
  mine: boolean;
}
interface Props {
  id: string;
  steps: Step[];
  heading: string;
  /** The visible tag on Raja's steps ("My part") */
  mineLabel: string;
  /** "state": the list follows a card in the deck (deck.ts sets data-state on each step). */
  sync?: 'state';
}
const { id, steps, heading, mineLabel, sync } = Astro.props;
const headingId = `${id}-steps`;
---

<div class="how">
  <p class="how-label" id={headingId}>{heading}</p>
  <ol class="steps" data-steps={id} data-sync={sync} aria-labelledby={headingId}>
    {
      steps.map((s) => (
        <li class:list={['step', s.mine && 'is-mine']} data-at={s.at}>
          <span class="mark" aria-hidden="true">
            <svg class="mark-on" viewBox="0 0 16 16" width="16" height="16">
              <circle cx="8" cy="8" r="8" />
              <path d="M4.5 8.2l2.3 2.3 4.7-5" />
            </svg>
          </span>
          <span class="step-text">
            <span class="step-words">{s.text}</span>
            {s.mine && (
              <>
                <span class="sr-only"> (my part)</span>
                <span class="mine-tag" aria-hidden="true">
                  {mineLabel}
                </span>
              </>
            )}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .how-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .steps {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.5rem;
    isolation: isolate;
  }
  .step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.125rem 0.5rem 0.125rem 0.25rem;
    margin-left: -0.25rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-fg);
  }
  /* The current step's highlight: only visible while its beat runs */
  .step::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    background-color: var(--color-raised);
    opacity: 0;
    z-index: -1;
  }
  .mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.1875rem;
    border: 2px solid var(--color-line-strong);
    border-radius: 999px;
  }
  .mark-on {
    position: absolute;
    inset: -2px;
    width: 1rem;
    height: 1rem;
  }
  /* A neutral tick for every step; lime only for Raja's */
  .mark-on circle {
    fill: var(--color-fg-subtle);
  }
  .is-mine .mark-on circle {
    fill: var(--color-accent);
  }
  .mark-on path {
    fill: none;
    stroke: var(--color-accent-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* "My part": an outlined pill in the accent colour (15:1 on the page, 13:1 on the highlight) */
  .mine-tag {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.4375rem;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25rem;
    color: var(--color-accent);
    white-space: nowrap;
    vertical-align: 0.0625rem;
  }

  .steps[data-sync='state'] .step[data-state='upcoming'] .mark-on {
    opacity: 0;
    transform: scale(0.6);
  }
  .steps[data-sync='state'] .step[data-state='upcoming'] .step-text {
    opacity: 0.62;
  }
  .steps[data-sync='state'] .step[data-state='active']::before {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .steps[data-sync='state'] .mark-on,
    .steps[data-sync='state'] .step-text,
    .steps[data-sync='state'] .step::before {
      transition:
        opacity 180ms linear,
        transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }
</style>
