---
/**
 * A scroll-scrubbed 3D scene: a rendered image sequence drawn on a canvas, scrubbed by the scroll
 * position (scrolling up plays it backwards). Reusable: AsaanBill first, TapitCard and Ladenza later.
 * Frames, posters and manifest.json come from tools/3d/encode_frames.py (public/scenes/<id>/).
 *
 * Slots: "intro" (name, role, badge, line, metric), "steps" (a ProductSteps list with sync="scroll"),
 * "outro" (My part, the story link).
 *
 * Layout
 * - 1024 px and wider: the whole thing pins below the header: the text column on the left (intro,
 *   steps, outro) and the 4:3 stage on the right, vertically centred. Scrub distance 280svh.
 * - Narrower: the intro scrolls normally; the stage and a compact step list pin; the outro follows.
 *   Scrub distance 220svh.
 * - Reduced motion, no JavaScript, data saver or 2G: nothing pins; the poster shows and every step
 *   is complete.
 * The stage is always the dark studio colour (the frames are composited over it).
 */
interface Props {
  id: string;
  manifest: {
    version: string;
    frames: number;
    beats: number[];
    background: string;
    pattern: string;
    framePad: number;
    posters: Record<'desktop' | 'phone', { webp: string; jpg: string }>;
  };
  alt: string;
  caption?: string;
  skipLabel: string;
  skipTo: string;
}
const { id, manifest: m, alt, caption, skipLabel, skipTo } = Astro.props;
const base = `/scenes/${id}/`;
const v = `?v=${m.version}`;
const sizes = '(min-width: 76rem) 41rem, (min-width: 64rem) 54vw, 100vw';
const webp = `${base}${m.posters.phone.webp}${v} 800w, ${base}${m.posters.desktop.webp}${v} 1440w`;
const jpg = `${base}${m.posters.phone.jpg}${v} 800w, ${base}${m.posters.desktop.jpg}${v} 1440w`;
---

<div
  class="ss"
  data-scroll-scene={id}
  data-base={base}
  data-frames={m.frames}
  data-beats={m.beats.join(',')}
  data-pattern={m.pattern}
  data-pad={m.framePad}
  data-version={m.version}
  data-bg={m.background}
  style={`--ss-bg: ${m.background}`}
>
  <a class="ss-skip" href={skipTo}>{skipLabel}</a>
  <div class="ss-inner">
    <div class="ss-head"><slot name="intro" /></div>
    <div class="ss-track">
      <div class="ss-pin">
        <figure class="ss-figure">
          <div class="ss-stage">
            <picture class="ss-poster">
              <source type="image/webp" srcset={webp} sizes={sizes} />
              <img src={`${base}${m.posters.desktop.jpg}${v}`} srcset={jpg} sizes={sizes} alt={alt} width="1440" height="1080" loading="lazy" decoding="async" />
            </picture>
            <canvas class="ss-canvas" aria-hidden="true"></canvas>
          </div>
          {caption && <figcaption class="ss-caption">{caption}</figcaption>}
        </figure>
        <div class="ss-steps"><slot name="steps" /></div>
      </div>
      <div class="ss-spacer" aria-hidden="true"></div>
    </div>
    <div class="ss-foot"><slot name="outro" /></div>
  </div>
</div>

<style>
  .ss {
    --ss-header: calc(4rem + 1px);
    position: relative;
  }
  .ss-skip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-control);
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 600;
    transform: translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }
  .ss-skip:focus-visible {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }
  .ss-inner {
    display: grid;
    gap: 1.25rem;
  }
  .ss-head,
  .ss-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .ss-pin {
    display: grid;
    gap: 1rem;
  }
  .ss-figure {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }
  /* The stage: a 4:3 box (no layout shift), always the dark studio colour */
  .ss-stage {
    position: relative;
    width: 100%;
    margin-inline: auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--ss-bg);
  }
  .ss-poster img,
  .ss-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ss-poster img {
    object-fit: contain;
    transition: opacity 200ms linear;
  }
  .ss[data-ready] .ss-poster img {
    opacity: 0;
  }
  .ss-caption {
    font-size: 0.8125rem;
    color: var(--color-fg-subtle);
    text-align: center;
  }
  .ss-spacer {
    display: none;
  }

  /* Wide screens: the text column and the stage side by side */
  @media (width >= 64rem) {
    .ss-inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-areas: 'head figure' 'steps figure' 'foot figure';
      align-content: center;
      column-gap: 3rem;
      row-gap: 1rem;
    }
    .ss-track,
    .ss-pin {
      display: contents;
    }
    .ss-head {
      grid-area: head;
    }
    .ss-steps {
      grid-area: steps;
    }
    .ss-foot {
      grid-area: foot;
    }
    .ss-figure {
      grid-area: figure;
      align-self: center;
    }
  }
  @media (width >= 80rem) {
    .ss-inner {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
  }

  /* Pinned and scrubbed: JavaScript on, motion allowed, no data saver */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.save-data)) .ss-track {
      position: relative;
    }
    :global(html.js:not(.save-data)) .ss-pin {
      position: sticky;
      top: var(--ss-header);
      padding-block: 0.75rem;
      background-color: var(--color-bg);
      z-index: 1;
    }
    :global(html.js:not(.save-data)) .ss-spacer {
      display: block;
      height: 220svh;
    }
    /* the stage never taller than the space left under the header and the compact steps */
    :global(html.js:not(.save-data)) .ss-stage {
      width: min(100%, calc((100svh - var(--ss-header) - 12rem) * 4 / 3));
    }
    :global(html.js:not(.save-data)) .ss-steps :global(.how-key) {
      display: none;
    }
    :global(html.js:not(.save-data)) .ss-steps :global(.steps) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.75rem;
    }
    :global(html.js:not(.save-data)) .ss-steps :global(.step) {
      font-size: 0.8125rem;
    }

    @media (width >= 64rem) {
      :global(html.js:not(.save-data)) .ss {
        height: calc(100svh - var(--ss-header) + 280svh);
      }
      :global(html.js:not(.save-data)) .ss-inner {
        position: sticky;
        top: var(--ss-header);
        height: calc(100svh - var(--ss-header));
      }
      :global(html.js:not(.save-data)) .ss-pin {
        position: static;
        padding: 0;
        background: none;
      }
      :global(html.js:not(.save-data)) .ss-spacer {
        display: none;
      }
      :global(html.js:not(.save-data)) .ss-stage {
        width: min(100%, calc((100svh - var(--ss-header) - 5rem) * 4 / 3));
      }
      :global(html.js:not(.save-data)) .ss-steps :global(.how-key) {
        display: flex;
      }
      :global(html.js:not(.save-data)) .ss-steps :global(.steps) {
        grid-template-columns: minmax(0, 1fr);
      }
      :global(html.js:not(.save-data)) .ss-steps :global(.step) {
        font-size: 0.9375rem;
      }
    }
    /* Short wide screens (720-800 px tall): tighten the column so it fits under the header */
    @media (width >= 64rem) and (height < 50rem) {
      :global(html.js:not(.save-data)) .ss-inner {
        row-gap: 0.625rem;
      }
      :global(html.js:not(.save-data)) .ss-head,
      :global(html.js:not(.save-data)) .ss-foot {
        gap: 0.4rem;
      }
      :global(html.js:not(.save-data)) .ss-steps :global(.step) {
        font-size: 0.875rem;
      }
    }
  }
</style>

<script>
  import { initScrollScenes } from '../scripts/scroll-scene';
  initScrollScenes();
</script>
