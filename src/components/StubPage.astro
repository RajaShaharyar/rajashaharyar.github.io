---
/**
 * Phase 1 stub: page title, a one-line purpose and a visible "Coming soon" note.
 * Each later phase replaces the stub with the real page.
 */
interface Props {
  eyebrow?: string;
  title: string;
  purpose: string;
  /** Build phase that delivers this page, e.g. "Phase 4 · Recognition" */
  phase: string;
}

const { eyebrow, title, purpose, phase } = Astro.props;
---

<section class="wrap py-16 md:py-24">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-4 max-w-4xl text-display-lg">{title}</h1>
  <p class="lead mt-6 max-w-prose">{purpose}</p>

  <div
    class="mt-12 flex max-w-prose flex-col gap-3 rounded-card border border-dashed border-line-strong bg-surface p-6 sm:flex-row sm:items-center sm:gap-5"
    role="note"
  >
    <span
      class="inline-flex w-fit items-center gap-2 rounded-full bg-accent px-3 py-1 text-sm font-semibold text-accent-ink"
    >
      <span class="size-1.5 rounded-full bg-accent-ink" aria-hidden="true"></span>
      Coming soon
    </span>
    <p class="text-fg-muted">
      This page is being written. <span class="text-fg-subtle">({phase})</span>
    </p>
  </div>

  <slot />
</section>
