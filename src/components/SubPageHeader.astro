---
/**
 * Top of a page inside a menu (Ventures, About, Recognition): a row of tabs for
 * the pages in that menu (handy on phones, where the main menu is folded away),
 * the eyebrow, the H1, an optional intro line and optional facts (a venture's
 * role, dates and location). Recognition is no longer in the top bar; its tabs
 * come from site.json → recognitionMenu. Only the menu's own pages are tabs: an
 * anchor on another page ("Yours next?") or a page outside the section (the CV in
 * the About menu) is not.
 * Slots: "logos" (under the H1: a venture's logo lockup) and "aside" (a venture's live card: on
 * the right from 1024 px, below the header text on narrower screens).
 * Phase 17: a full-bleed band. By default near-black with a violet-led aurora and grain; with band
 * (a colour token name: a venture's deck colour) a solid band in that colour with ink text.
 */
import Aurora from './Aurora.astro';
import { site, withSlash } from '../lib/site';

interface Props {
  /** The menu's own href in site.json → nav, e.g. "/about/" */
  section: string;
  title: string;
  intro?: string;
  /** Add a first tab for the menu's overview page (when it isn't one of the menu's children) */
  overviewLabel?: string;
  /** Label/value pairs shown under the intro (empty values are left out) */
  facts?: { label: string; value: string | null | undefined }[];
  /** A colour token name (accent, accent-2, fg, accent-strong, accent-2-soft): a solid band with ink text */
  band?: string;
}

const { section, title, intro, overviewLabel, facts = [], band } = Astro.props;
// Ink on a band: lime fills take the lime inks, violet and off-white fills the violet inks (all >= 4.5:1).
const limeFill = band === 'accent' || band === 'accent-strong';
const bandStyle = band
  ? `--band-bg:var(--color-${band});--ink:var(--color-${limeFill ? 'accent-ink' : 'accent-2-ink'});--ink-muted:var(--color-${limeFill ? 'accent-ink-muted' : 'accent-2-ink-muted'})`
  : undefined;
const menu = [...site.nav, site.recognitionMenu].find((item) => item.href === section);
const children = (menu?.children ?? []).filter((c) => !c.href.includes('#') && withSlash(c.href).startsWith(withSlash(section)));
const shownFacts = facts.filter((f): f is { label: string; value: string } => Boolean(f.value));
const pages = overviewLabel && !children.some((c) => withSlash(c.href) === withSlash(section)) ? [{ label: overviewLabel, href: section }, ...children] : children;
const path = withSlash(Astro.url.pathname);
const hasAside = Astro.slots.has('aside');
---

<header class:list={['page-header band', band ? 'band-fill' : 'page-header-aurora', hasAside && 'has-aside']} style={bandStyle} data-band={band}>
  {!band && <Aurora id="grain-header" />}
  <div class="wrap pt-8 pb-12 md:pt-12 md:pb-16">
    <nav aria-label={`${menu?.label ?? ''} pages`}>
      <ul class="flex flex-wrap gap-2">
        {
          pages.map((page) => (
            <li>
              <a href={page.href} class="sub-tab" aria-current={withSlash(page.href) === path ? 'page' : undefined}>
                {page.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="page-header-grid">
      <div class="page-header-text">
        <p class="eyebrow mt-10 md:mt-14">{menu?.label}</p>
        <h1 class="mt-4 max-w-4xl text-display-lg">{title}</h1>
        <slot name="logos" />
        {intro && <p class="lead mt-6 max-w-prose">{intro}</p>}
        {
          shownFacts.length > 0 && (
            <dl class="header-facts">
              {shownFacts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {
        hasAside && (
          <div class="page-header-aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  /* With a live card: text on the left, the card on the right from 1024 px; below the text before that */
  .page-header-aside {
    margin-top: 2.5rem;
    width: min(100%, 26rem);
  }
  @media (width >= 64rem) {
    .has-aside .page-header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
      column-gap: 4rem;
      align-items: end;
    }
    .page-header-aside {
      width: 100%;
      margin-top: 2.5rem;
    }
  }
  /* On a colour band: ink text, ink tabs, and a shadow so the live card reads on its own colour */
  .band-fill .header-facts dt {
    color: var(--ink-muted);
  }
  .band-fill .header-facts dd {
    color: var(--ink);
  }
  .band-fill .sub-tab {
    color: var(--ink);
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .band-fill .sub-tab:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .band-fill .sub-tab[aria-current='page'] {
    color: var(--band-bg);
    border-color: var(--ink);
    background-color: var(--ink);
  }
  .band-fill .page-header-aside :global(.deck-card) {
    box-shadow:
      0 0 0 1px rgb(11 12 14 / 0.12),
      0 40px 80px -36px rgb(11 12 14 / 0.55);
  }
  .header-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 1.75rem;
  }
  .header-facts dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .header-facts dd {
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    color: var(--color-fg);
  }
  .sub-tab {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .sub-tab:hover {
    color: var(--color-fg);
    border-color: var(--color-line-strong);
  }
  .sub-tab[aria-current='page'] {
    color: var(--color-fg);
    border-color: var(--color-fg);
    background-color: var(--color-raised);
  }
</style>
