---
/**
 * One venture card (/ventures). The whole card is clickable through its
 * single "Read the journey →" link (no duplicate links for screen readers).
 * One visual style for every card (Phase 20): a small static version of the venture's deck card on a dark
 * panel (VentureThumb: deck colour, product visual, final frame). Event photos stay on the venture pages.
 */
import VentureThumb from './VentureThumb.astro';
import type { Venture } from '../lib/site';

interface Props {
  venture: Venture;
  linkLabel: string;
}

const { venture: v, linkLabel } = Astro.props;
---

<article class="venture-card lift-card flex h-full flex-col rounded-card border border-line bg-surface" data-spotlight>
  <div class="card-media-top venture-art border-b border-line">
    <VentureThumb id={v.id} name={v.name} meta={v.meta} />
  </div>
  <div class="flex flex-1 flex-col gap-4 p-6 md:p-8">
    <!-- Meta and badge on separate rows so headings line up across cards -->
    <div class="flex flex-col items-start gap-2">
      <p class="text-sm text-fg-muted">{v.meta}</p>
      {
        v.badge ? (
          <p class="badge">
            <span class="sr-only">Stage reached: </span>
            {v.badge}
          </p>
        ) : (
          <p class="badge invisible" aria-hidden="true">&nbsp;</p>
        )
      }
    </div>
    <h3 class="text-2xl md:text-3xl">{v.name}</h3>
    {
      v.metric && (
        <p class="flex flex-wrap items-baseline gap-x-2">
          <span class="font-display text-number font-semibold tracking-tight text-accent tabular-nums">
            {v.metric.value}
          </span>
          <span class="text-fg-muted">{v.metric.label}</span>
        </p>
      )
    }
    <p class="max-w-prose text-fg-muted">{v.line}</p>
    <a href={v.href} class="arrow-link card-link mt-auto pt-2">
      {linkLabel}
      <span class="sr-only">: {v.name}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  /* The thumbnail's panel: a 16:10 dark frame, the square deck card centred at 84% of its height */
  .venture-art {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding-block: 8%;
    overflow: hidden;
    background-color: var(--color-raised);
  }
  /* Hover and focus lift: .lift-card in global.css. Stretch the link over the whole card */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card-link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
