---
/**
 * Homepage section 4: one venture. The whole card is clickable through its
 * single "Read the journey →" link (no duplicate links for screen readers).
 */
import Media from './Media.astro';
import type { Venture } from '../lib/site';

interface Props {
  venture: Venture;
  linkLabel: string;
}

const { venture: v, linkLabel } = Astro.props;
---

<article class="venture-card lift-card flex h-full flex-col rounded-card border border-line bg-surface">
  {
    v.image && (
      <Media
        image={v.image.src}
        fit={v.image.fit}
        position={v.image.position}
        sizes="(min-width: 768px) 600px, 100vw"
        class="card-media-top aspect-video border-b border-line"
      />
    )
  }
  <div class="flex flex-1 flex-col gap-4 p-6 md:p-8">
    <!-- Meta and badge on separate rows so headings line up across cards -->
    <div class="flex flex-col items-start gap-2.5">
      <p class="text-sm text-fg-muted">{v.meta}</p>
      {
        v.badge && (
          <p class="badge">
            <span class="sr-only">Stage reached: </span>
            {v.badge}
          </p>
        )
      }
    </div>
    <h3 class="text-3xl md:text-4xl">{v.name}</h3>
    {
      v.metric && (
        <p class="flex flex-wrap items-baseline gap-x-2.5">
          <span class="font-display text-4xl font-semibold tracking-tight text-accent tabular-nums md:text-5xl">
            {v.metric.value}
          </span>
          <span class="text-fg-muted">{v.metric.label}</span>
        </p>
      )
    }
    <p class="max-w-prose text-fg-muted">{v.line}</p>
    <a href={v.href} class="arrow-link card-link mt-auto pt-2">
      {linkLabel}
      <span class="sr-only">: {v.name}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  /* Hover and focus lift: .lift-card in global.css. Stretch the link over the whole card */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card-link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>
