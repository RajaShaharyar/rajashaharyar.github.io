---
/**
 * Homepage #products, "The work": a pinned deck with one card per venture (home.json →
 * products.cards). Minimal text (Phase 17; the details live on the venture pages): the venture's
 * name (an H3, the largest text on the left), its tagline (home.json → products.items[].headline,
 * a draft) in violet, the one line (muted, at most two lines), the metric if it has one (a lime
 * number) and "Read the story →". Name, line, metric and link: site.json → ventures; tagline,
 * label and card colour (a colour token name, e.g. "accent-2" → var(--color-accent-2)): home.json
 * → products.items.
 *
 * - From 1024 px (and 600 px tall): the left column holds the heading, the progress rail and the
 *   active venture's text; the right column holds the deck. Each card gets 70svh of scroll; the
 *   next card rises over the stack, earlier cards peek out underneath.
 * - Narrower and at least 640 px tall: heading, the active text and the card, pinned. Shorter: a
 *   plain list, each card playing while it is in view.
 * - Reduced motion and no JavaScript: a plain list of cards in their final state.
 * - Every text block stays in the DOM and the accessibility tree (inactive ones are only visually
 *   hidden); the animations are aria-hidden. Behaviour: src/scripts/deck.ts.
 * - Each card is a DeckCard (also used in each venture page's header): AsaanBill's is its real
 *   portal UI rebuilt as live HTML, TapitCard's its real card artwork in CSS 3D, the other three
 *   their SVG scenes. Every inner panel fades out at its edges.
 */
import { getEntry } from 'astro:content';
import DeckCard from './DeckCard.astro';
import ArrowLink from './ArrowLink.astro';
import home from '../content/home.json';
import { site } from '../lib/site';

const copy = home.products;

async function card(id: string, i: number) {
  const venture = site.ventures.find((v) => v.id === id);
  const story = copy.items.find((s) => s.id === id);
  const entry = await getEntry('ventures', id);
  if (!venture || !story || !entry) throw new Error(`home.json → products: "${id}" needs a site.json venture, a products.items entry and a venture file.`);
  return { ...venture, i, label: story.label, tagline: story.headline };
}
const cards = await Promise.all(copy.cards.map(card));
const N = cards.length;
---

<section id="products" class="deck-section defer-render" aria-labelledby="products-heading" style={`--defer-size: ${Math.round(100 + (N - 0.65) * 70)}svh`}>
  <a class="deck-skip" href="#playbook">{copy.skipLabel}</a>
  <div class="deck wrap" data-deck style={`--n: ${N}`}>
    <div class="deck-pin">
      <header class="deck-head">
        <h2 id="products-heading" class="deck-title">{copy.heading}</h2>
        <p class="deck-intro">{copy.intro}</p>
      </header>

      <nav class="deck-rail" aria-label={copy.railLabel}>
        <ol>
          {
            cards.map((c, i) => (
              <li>
                <button type="button" data-rail aria-label={`Show ${c.name}`} aria-current={i === 0 ? 'true' : undefined}>
                  <span class="deck-rail-line" />
                  <span class="deck-rail-name" aria-hidden="true">
                    {c.label}
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="deck-texts">
        {
          cards.map((c, i) => (
            <article class:list={['deck-text', i === 0 && 'is-active']} data-card-text id={`work-${c.id}`} aria-labelledby={`work-${c.id}-h`} style={`--row-m:${2 * i + 2};--row-d:${i + 2}`}>
              <h3 class="deck-name" id={`work-${c.id}-h`}>
                {c.name}
              </h3>
              <p class="deck-tagline">{c.tagline}</p>
              <p class="deck-line">{c.line}</p>
              {c.metric && (
                <p class="deck-metric">
                  <span class="deck-metric-value">{c.metric.value}</span> {c.metric.label}
                </p>
              )}
              <a href={c.href} class="btn btn-secondary deck-link">
                {copy.storyLink}
                <span class="sr-only">: {c.name}</span>
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>

      <div class="deck-stack">
        {
          cards.map((c, i) => (
            <DeckCard id={c.id} pos={i === 0 ? 'active' : 'future'} style={`--row-mc:${2 * i + 3};--row-d:${i + 2};z-index:${i + 1}`} />
          ))
        }
        <button type="button" class="deck-toggle" data-deck-toggle aria-label={copy.pauseLabel} data-pause={copy.pauseLabel} data-play={copy.playLabel} hidden>
          <svg class="deck-icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
          <svg class="deck-icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.5 8z" /></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="wrap">
    <ArrowLink href={copy.otherLink.href} class="mt-2">{copy.otherLink.label}</ArrowLink>
  </div>
</section>

<script>
  import { initDeck } from '../scripts/deck';
  initDeck();
</script>

<style>
  .deck-section {
    --hh: calc(4rem + 1px);
    position: relative;
    padding-block: 3.5rem;
  }
  .deck-skip {
    position: absolute;
    left: 1rem;
    top: 0.75rem;
    z-index: 20;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-control);
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.5rem);
  }
  .deck-skip:focus-visible {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  /* ------------------------------------------------------------ text */
  .deck-title {
    font-size: var(--text-display-md);
    line-height: var(--text-display-md--line-height);
    letter-spacing: var(--text-display-md--letter-spacing);
  }
  .deck-intro {
    margin-top: 0.5rem;
    color: var(--color-fg-muted);
    font-size: var(--text-lead);
  }
  .deck-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    min-width: 0;
  }
  /* The venture's name is the most prominent text on the left (display-lg) */
  .deck-name {
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    letter-spacing: var(--text-display-lg--letter-spacing);
  }
  .deck-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-accent-2);
  }
  /* The one line: muted, at most two lines (the full text stays in the page for screen readers) */
  .deck-line {
    max-width: 30rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  @media (64rem <= width < 80rem) {
    .deck-line {
      font-size: 0.9375rem; /* the longest line still fits in two at 1024 px */
    }
  }
  .deck-metric {
    color: var(--color-fg-muted);
  }
  .deck-metric-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .deck-link {
    margin-top: 0.5rem;
  }

  /* ------------------------------------------------------------ plain list (default) */
  /* A large soft violet glow behind the cards (static) */
  .deck-pin {
    background-image: radial-gradient(48% 52% at 50% 70%, rgb(167 139 250 / 0.16), rgb(167 139 250 / 0) 72%);
    background-image: radial-gradient(48% 52% at 50% 70% in oklch, rgb(167 139 250 / 0.16), rgb(167 139 250 / 0) 72%);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  .deck-head {
    grid-row: 1;
    grid-column: 1 / -1;
    margin-bottom: 0.5rem;
  }
  .deck-rail {
    display: none;
  }
  .deck-texts,
  .deck-stack {
    display: contents;
  }
  .deck-text {
    grid-row: var(--row-m);
  }
  .deck :global(.deck-card) {
    grid-row: var(--row-mc);
    width: min(100%, 36rem);
    margin-bottom: 1.75rem;
  }
  .deck :global(.deck-toggle) {
    display: none;
  }
  @media (width >= 64rem) {
    .deck-pin {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
      gap: 3rem 3.5rem;
    }
    .deck-text {
      grid-column: 1;
      grid-row: var(--row-d);
      align-self: center;
    }
    .deck :global(.deck-card) {
      grid-column: 2;
      grid-row: var(--row-d);
      width: min(100%, 34rem);
      margin-bottom: 0;
      justify-self: center;
    }
  }

  /* ------------------------------------------------------------ pinned deck (shared) */
  @media (prefers-reduced-motion: no-preference) and (width >= 64rem) and (height >= 37.5rem),
    (prefers-reduced-motion: no-preference) and (width < 64rem) and (height >= 40rem) {
    :global(html.js) .deck-section {
      padding-block: 0 1.5rem;
    }
    :global(html.js) .deck {
      /* every card but the last gets 70svh of scroll; the last only a short hold (0.35 of a step), so the
         pin releases soon after it lands instead of leaving a long empty stretch (deck.ts: TAIL) */
      height: calc(100svh - var(--hh) + (var(--n) - 0.65) * 70svh);
    }
    :global(html.js) .deck-pin {
      position: sticky;
      top: var(--hh);
      height: calc(100svh - var(--hh));
      overflow: clip;
    }
    :global(html.js) .deck-texts {
      display: grid;
    }
    :global(html.js) .deck-text {
      grid-area: 1 / 1;
      opacity: 0;
      transform: translateY(10px);
      pointer-events: none;
      transition:
        opacity 150ms linear,
        transform 150ms linear;
    }
    :global(html.js) .deck-text.is-active {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition:
        opacity 250ms var(--ease-out-quart) 150ms,
        transform 250ms var(--ease-out-quart) 150ms;
    }
    :global(html.js) .deck-stack {
      display: block;
      position: relative;
      aspect-ratio: 1;
    }
    :global(html.js) .deck :global(.deck-card) {
      position: absolute;
      inset: 0;
      width: auto;
      margin: 0;
      transition: transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    :global(html.js) .deck :global(.deck-card::after) {
      transition: opacity 650ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    /* below the viewport: at least a full pinned height down (110% alone can peek on tall screens) */
    :global(html.js) .deck :global(.deck-card[data-pos='future']) {
      transform: translateY(max(110%, calc(100svh - var(--hh) + 3rem))) rotate(8deg);
      pointer-events: none;
    }
    :global(html.js) .deck :global(.deck-card[data-pos='past']) {
      transform: translateY(calc(var(--depth) * -14px)) rotate(-4deg) scale(0.97);
      pointer-events: none;
    }
    :global(html.js) .deck :global(.deck-card[data-pos='past']::after) {
      opacity: 0.3;
    }
    :global(html.js) .deck :global(.deck-card[data-pos='past'][data-depth='2']),
    :global(html.js) .deck :global(.deck-card[data-pos='past'][data-depth='4']) {
      transform: translateY(calc(var(--depth) * -14px)) rotate(5deg) scale(0.97);
    }
    :global(html.js) .deck :global(.deck-toggle) {
      display: grid;
    }
    :global(html.js) .deck :global(.deck-toggle[hidden]) {
      display: none;
    }
  }

  /* ------------------------------------------------------------ pinned: wide screens */
  @media (prefers-reduced-motion: no-preference) and (width >= 64rem) and (height >= 37.5rem) {
    :global(html.js) .deck-pin {
      background-image: radial-gradient(38% 58% at 72% 55%, rgb(167 139 250 / 0.17), rgb(167 139 250 / 0) 72%);
      background-image: radial-gradient(38% 58% at 72% 55% in oklch, rgb(167 139 250 / 0.17), rgb(167 139 250 / 0) 72%);
      grid-template-columns: 2.25rem minmax(0, 4fr) minmax(0, 6fr);
      grid-template-rows: auto minmax(0, 1fr);
      column-gap: 1.25rem;
      row-gap: 1.25rem;
      align-items: center;
      padding-block: 2rem;
    }
    :global(html.js) .deck-head {
      grid-column: 1 / 3;
      grid-row: 1;
      align-self: start;
      margin: 0;
    }
    :global(html.js) .deck-rail {
      display: block;
      grid-column: 1;
      grid-row: 2;
      align-self: center;
    }
    :global(html.js) .deck-texts {
      grid-column: 2;
      grid-row: 2;
      align-self: center;
    }
    :global(html.js) .deck-stack {
      grid-column: 3;
      grid-row: 1 / 3;
      justify-self: center;
      width: min(640px, 50vw, calc(100svh - var(--hh) - 4rem));
    }
  }
  /* The rail: one short line per card; the active one is longer, with the venture's name */
  .deck-rail ol {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
  }
  .deck-rail button {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    width: 2.25rem;
    padding: 0.375rem 0;
    cursor: pointer;
    color: var(--color-fg-subtle);
  }
  .deck-rail-line {
    width: 3px;
    height: 1.25rem;
    border-radius: 3px;
    background-color: var(--color-line-strong);
    transition:
      height 300ms var(--ease-out-quart),
      background-color 300ms;
  }
  .deck-rail-name {
    display: none;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-fg);
  }
  .deck-rail button:hover .deck-rail-line {
    background-color: var(--color-fg-muted);
  }
  .deck-rail button[aria-current] .deck-rail-line {
    height: 3rem;
    background-color: var(--color-accent);
  }
  .deck-rail button[aria-current] .deck-rail-name {
    display: block;
  }
  /* ------------------------------------------------------------ pinned: phones and tablets */
  @media (prefers-reduced-motion: no-preference) and (width < 64rem) and (height >= 40rem) {
    /* the "Let's talk" dock covers the bottom 4.75rem on small screens */
    :global(html.js) .deck {
      height: calc(100svh - var(--hh) - 4.75rem - env(safe-area-inset-bottom) + (var(--n) - 0.65) * 70svh);
    }
    :global(html.js) .deck-pin {
      height: calc(100svh - var(--hh) - 4.75rem - env(safe-area-inset-bottom));
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-block: 0.75rem;
    }
    :global(html.js) .deck-title {
      font-size: 1.25rem;
      line-height: 1.2;
    }
    :global(html.js) .deck-intro {
      display: none;
    }
    :global(html.js) .deck-text {
      gap: 0.375rem;
    }
    /* the text (and its button) always above the cards that peek out of the stack */
    :global(html.js) .deck-texts {
      position: relative;
      z-index: 40;
    }
    :global(html.js) .deck :global(.deck-card[data-pos='past']) {
      transform: translateY(calc(var(--depth) * -6px)) rotate(-2.5deg) scale(0.97);
    }
    :global(html.js) .deck :global(.deck-card[data-pos='past'][data-depth='2']),
    :global(html.js) .deck :global(.deck-card[data-pos='past'][data-depth='4']) {
      transform: translateY(calc(var(--depth) * -6px)) rotate(3deg) scale(0.97);
    }
    :global(html.js) .deck-stack {
      margin-top: 0.75rem;
    }
    :global(html.js) .deck-name {
      font-size: clamp(2rem, 1.2rem + 3.4vw, 2.75rem);
    }
    :global(html.js) .deck-tagline {
      font-size: 1.125rem;
    }
    :global(html.js) .deck-line {
      font-size: 0.9375rem;
      line-height: 1.4;
    }
    :global(html.js) .deck-metric-value {
      font-size: 1.25rem;
    }
    :global(html.js) .deck-link {
      margin-top: 0.25rem;
    }
    /* the deck takes the height that is left; the card is the largest square that fits */
    :global(html.js) .deck-stack {
      flex: 1 1 0;
      min-height: 11rem;
      width: 100%;
      aspect-ratio: auto;
      container-type: size;
    }
    :global(html.js) .deck :global(.deck-card) {
      inset: auto;
      top: 0;
      left: calc((100cqw - min(100cqw, 100cqh)) / 2);
      width: min(100cqw, 100cqh);
      height: min(100cqw, 100cqh);
    }
    :global(html.js) .deck :global(.deck-toggle) {
      right: calc((100cqw - min(100cqw, 100cqh)) / 2 + 8px);
      bottom: calc(100cqh - min(100cqw, 100cqh) + 8px);
    }
  }
</style>
