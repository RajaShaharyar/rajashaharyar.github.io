---
/**
 * Base layout for every page: SEO basics (title template, description,
 * canonical, Open Graph, Twitter card, Person JSON-LD), nav, footer and the
 * mobile-docked "Let's talk" button (in an aside landmark, "Quick contact").
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/global.css';
// The two latin font files, preloaded so text renders in its final font sooner (less layout shift on swap).
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, withSlash } from '../lib/site';
import { publicFileExists } from '../lib/public-files';

interface Props {
  /** Page title; rendered as "Title — Raja Shaharyar Ali". Omit on the home page. */
  title?: string;
  description?: string;
  ogType?: 'website' | 'profile';
  /** Hide the mobile-docked "Let's talk" button (e.g. on /contact). */
  hideDock?: boolean;
  /** For the 404 page: no canonical, not indexed. */
  noindex?: boolean;
  /** The page's LCP image, preloaded with high priority (the homepage hero portrait) */
  preloadImage?: { src: string; srcset: string; sizes: string };
}

const {
  title,
  description = site.description,
  ogType = 'website',
  hideDock = false,
  noindex = false,
  preloadImage,
} = Astro.props;

// Title template
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.title}`;
const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(withSlash(Astro.url.pathname), siteUrl).href;
const ogLocale = site.locale.replace('-', '_');

// Share image per page (npm run og writes public/og/<slug>.png); falls back to the homepage card.
const ogSlug = withSlash(Astro.url.pathname).split('/').filter(Boolean).join('-').replace(/\.html$/, '') || 'home';
const ogPath = publicFileExists(`/og/${ogSlug}.png`) ? `/og/${ogSlug}.png` : '/og/home.png';
const ogImage = new URL(ogPath, siteUrl).href;
const ogAlt = `${title ?? site.title}: ${site.name}`;

// Structured data: Person on every page, WebSite on the homepage.
const homeUrl = new URL('/', siteUrl).href;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${homeUrl}#person`,
  name: site.name,
  url: homeUrl,
  image: new URL('/og/home.png', siteUrl).href,
  jobTitle: site.title,
  worksFor: { '@type': 'Organization', name: site.company },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressCountry: site.location.countryCode,
  },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Air University, Islamabad' },
  knowsAbout: ['Product management', 'Growth', 'Go-to-market', 'Fintech', 'Digital payments', 'SaaS'],
  sameAs: [site.contact.linkedin.href, site.contact.digitalCard.href],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: homeUrl,
  description: site.description,
  inLanguage: site.locale,
  author: { '@id': `${homeUrl}#person` },
};
const toJson = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
const isHome = withSlash(Astro.url.pathname) === '/';

// Optional, cookie-free analytics (site.json → analytics). Off while provider is "".
const analytics = site.analytics;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script is:inline type="application/ld+json" set:html={toJson(personLd)} />
    {isHome && <script is:inline type="application/ld+json" set:html={toJson(websiteLd)} />}

    <!-- Analytics: cookie-free, off unless site.json → analytics.provider is set -->
    {
      analytics.provider === 'goatcounter' && analytics.id && (
        <script is:inline async data-goatcounter={`https://${analytics.id}.goatcounter.com/count`} src="https://gc.zgo.at/count.js" />
      )
    }
    {
      analytics.provider === 'cloudflare' && analytics.id && (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analytics.id })} />
      )
    }
    {analytics.provider === 'plausible' && analytics.id && <script is:inline defer data-domain={analytics.id} src="https://plausible.io/js/script.js" />}
  </head>
  <body class:list={['flex min-h-dvh flex-col', !hideDock && 'has-dock']}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />

    {
      !hideDock && (
        <aside class="dock" aria-label="Quick contact" data-dock>
          <a href={site.cta.href} class="btn btn-primary w-full">
            {site.cta.label}
          </a>
        </aside>
      )
    }
    <script>
      import '../scripts/reveal';
      import '../scripts/ambient';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-control);
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 0.75rem;
  }
  main:focus {
    outline: none;
  }

  /* "Let's talk" docks to the bottom of the screen on small screens. */
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-top: 1px solid var(--color-line);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  body.has-dock {
    padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
  }

  @media (width < 64rem) {
    html.nav-open {
      overflow: hidden;
    }
  }

  @media (width >= 64rem) {
    .dock {
      display: none;
    }
    body.has-dock {
      padding-bottom: 0;
    }
  }
</style>
