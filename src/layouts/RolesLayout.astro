---
/**
 * Consulting & product roles (/ventures/consulting): not a case study, a page
 * of role cards. Order and copy come from src/content/ventures/consulting.mdx;
 * each card's facts come from src/content/cv.json → experience (company, role,
 * dates, what they built, what Raja did), so the CV and this page never
 * disagree. The first role is the wide featured card. Dates that are still a
 * TODO are hidden; an outcome shows only where one exists.
 */
import Base from './Base.astro';
import SubPageHeader from '../components/SubPageHeader.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { bulletText, getExperience, roleDates } from '../lib/cv';
import type { RolesPage } from '../lib/ventures';

interface Props {
  data: RolesPage;
}

const { data } = Astro.props;
const cards = data.roles.map((id, i) => {
  const item = getExperience(id);
  const role = item.roles[0];
  return {
    id,
    company: item.company,
    meta: [role.title, roleDates(role), item.product].filter(Boolean).join(' · '),
    bullets: role.bullets.map((b) => bulletText(b)),
    outcome: i === 0 ? data.featuredNote : undefined,
    featured: i === 0,
  };
});
---

<Base title={data.title} description={data.summary}>
  <ReadingProgress />
  <SubPageHeader section="/ventures/" overviewLabel="Overview" title={data.title} intro={data.intro} />

  <section class="wrap pt-10 md:pt-14" aria-label="Roles">
    <ul class="grid gap-4 md:grid-cols-3 md:gap-6" data-reveal-stagger>
      {
        cards.map((c) => (
          <li id={c.id} class:list={['role', c.featured && 'role-featured md:col-span-3']}>
            <div class="role-head">
              <h2 class="role-company">{c.company}</h2>
              <p class="role-meta">{c.meta}</p>
            </div>
            <div class="role-body">
              <ul class="role-bullets">
                {c.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {c.outcome && <p class="role-outcome">{c.outcome}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pt-16 pb-4 md:pt-20" aria-labelledby="roles-cta-heading">
    <div class="roles-cta">
      <h2 id="roles-cta-heading" class="text-display-md">{data.cta.heading}</h2>
      <ArrowLink href={data.cta.link.href} class="text-lg">{data.cta.link.label}</ArrowLink>
    </div>
  </section>
</Base>

<style>
  .role {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }
  @media (width >= 48rem) {
    .role {
      padding: 1.75rem;
    }
  }
  .role-company {
    font-size: 1.625rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .role-meta {
    margin-top: 0.5rem;
    color: var(--color-fg-muted);
  }
  .role-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.125rem;
    list-style: disc;
    color: var(--color-fg-muted);
  }
  .role-bullets li::marker {
    color: var(--color-accent);
  }
  .role-outcome {
    margin-top: 1.25rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-fg);
  }

  /* Featured (HOMS): wide, with the outcome beside the bullets on desktop */
  .role-featured {
    border-color: var(--color-line-strong);
  }
  @media (width >= 48rem) {
    .role-featured {
      padding: 2.25rem;
    }
    .role-featured .role-company {
      font-size: var(--text-display-md);
    }
    .role-featured .role-meta {
      font-size: var(--text-lead);
    }
    .role-featured .role-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
    .role-featured .role-outcome {
      margin-top: 0;
      font-size: 1.5rem;
    }
  }

  .roles-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-line);
  }
</style>
