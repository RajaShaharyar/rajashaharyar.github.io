---
/**
 * The case-study template (Phase 18, from the new sitemap): every venture page (AsaanBill, TapitCard,
 * DressUp AI, Sonic AI Engine, Ladenza), fed by one MDX file's frontmatter (schema: src/content.config.ts).
 * Two kinds share it: case-study (AsaanBill, TapitCard, Ladenza) and role-story (DressUp AI, Sonic AI
 * Engine, built from one cv.json experience entry). Eight sections, in order:
 *   1 #snapshot     H1 name, logo where there is one, one line, role, dates (hidden while TODO), team, up
 *                   to 3 key numbers, the stage reached and the product link
 *   2 #visual       the live venture card, large and centred (DeckCard; the page's only autoplay:
 *                   src/scripts/venture-card.ts), on a soft glow in the venture's colour
 *   3 #challenge    the problem and the market (role stories: the product, from its own site), then any
 *                   limitations
 *   4 #contribution what Raja did: the Product-Idea Fit / Product-Market Fit / Scale narrative (anchors
 *                   #product-idea-fit, #product-market-fit, #scale), Payments and approvals (#approvals),
 *                   How a merchant goes live (#journey), Terms used (#terms), Who did what (#team); role
 *                   stories: What I did
 *   5 #result       the outcome line, the results grid and its definition (and lessons, once there are any)
 *   6 #evidence     one gallery: the product screens first ("In pictures"), then events, MOUs and press,
 *                   never the same photo twice
 *   7 #testimonial  site.json → testimonials whose venture is this one (hidden while there are none)
 *   8 #enabled      What this enabled (frontmatter enabled, a draft built only from facts on the page;
 *                   hidden while missing)
 * Then the next case study and the closing CTA panel. A section with no data is left out, and so is its
 * entry in the sticky "On this page" list (desktop). A value that is still "TODO: …" counts as missing.
 */
import Base from './Base.astro';
import SubPageHeader from '../components/SubPageHeader.astro';
import StageSpine from '../components/StageSpine.astro';
import JourneyFlow from '../components/JourneyFlow.astro';
import DataTable from '../components/DataTable.astro';
import Counter from '../components/Counter.astro';
import Gallery from '../components/Gallery.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import DeckCard from '../components/DeckCard.astro';
import Testimonial from '../components/Testimonial.astro';
import CTA from '../components/CTA.astro';
import home from '../content/home.json';
import { getImage } from '../lib/images';
import { site, filled } from '../lib/site';
import { bulletText, getExperience, roleDates } from '../lib/cv';
import { getRecognition, photosOf } from '../lib/recognition';
import { preSalesText, type CaseStudy, type RoleStory } from '../lib/ventures';

interface Props {
  id: string;
  data: CaseStudy | RoleStory;
}

const { id, data } = Astro.props;
const cs = data.kind === 'case-study' ? data : undefined;
const rs = data.kind === 'role-story' ? data : undefined;
const card = site.ventures.find((v) => v.id === id);

// Role story: everything about the role comes from cv.json → experience
const experience = rs ? getExperience(rs.experienceId) : undefined;
const role = experience?.roles[0];

// 1. Snapshot: role, dates (hidden while TODO), team; up to 3 key numbers
const snapshotFacts = cs
  ? [
      { label: 'Role', value: cs.snapshot.role },
      { label: 'Dates', value: filled(cs.snapshot.dates) },
      { label: 'Team', value: filled(cs.snapshot.team) },
    ]
  : [
      { label: 'Role', value: role?.title },
      { label: 'Dates', value: role ? filled(roleDates(role)) : undefined },
    ];
const keyNumbers = (cs?.snapshot.metrics ?? []).slice(0, 3);
// External link only once its href is real (Ladenza's Instagram is still a TODO)
const external = data.external && filled(data.external.href)?.startsWith('http') ? data.external : undefined;
const logo = data.logo ? { main: getImage(data.logo.image), by: data.logo.by ? getImage(data.logo.by) : undefined } : undefined;

// 2. Visual: the live card (every venture with a homepage deck card has one)
const deckItem = home.products.items.find((item) => item.id === id);
const copy = home.products;

// 3. Challenge
const problemText = filled(data.problem?.text);
const pain = filled(cs?.problem.pain);
const about = rs?.about;

// 4. Contribution: the stages (case studies), with the homepage playbook's question for each
const preSales = preSalesText(cs?.preSales);
const stageBlocks = cs
  ? [
      { id: 'product-idea-fit', name: 'Product-Idea Fit', stage: cs.stages.ideaFit },
      { id: 'product-market-fit', name: 'Product-Market Fit', stage: cs.stages.marketFit },
      { id: 'scale', name: 'Scale', stage: cs.stages.scale },
    ]
      .map((b, i) => ({
        ...b,
        number: String(i + 1).padStart(2, '0'),
        question: home.playbook.stages.find((s) => s.id === b.id)?.question,
        text: preSales && b.stage.textWithPreSales ? b.stage.textWithPreSales.replace('{preSales}', preSales) : b.stage.text,
        reached: cs.snapshot.stage === b.name,
      }))
      .filter((b) => filled(b.text))
  : [];
const spotlight = cs?.spotlight;
const journey = cs?.journey;
const glossary = cs?.glossary ?? [];
const contributions = cs?.contributions ?? [];

// 6. Evidence: the product screens first, then events and MOUs, then press; no photo twice
const evidencePhotos = data.evidenceIds.map(getRecognition).flatMap((item) => photosOf(item).map((p) => ({ image: p.file, caption: p.caption })));
const seen = new Set<string>();
const gallery = [...data.pictures.map((image) => ({ image })), ...evidencePhotos].filter((p) => !seen.has(p.image) && Boolean(seen.add(p.image)));
const press = cs?.press ?? [];

// 7. Testimonials for this venture (site.json → testimonials[].venture)
const testimonials = site.testimonials.filter((t) => t.venture === id);
// 8. What this enabled
const enabled = data.enabled;

const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, '');
const sections = [
  { id: 'snapshot', label: 'Snapshot', show: true },
  { id: 'visual', label: 'Visual', show: Boolean(deckItem) },
  { id: 'challenge', label: 'Challenge', show: Boolean(problemText || about || data.limitations.length) },
  { id: 'contribution', label: 'Contribution', show: Boolean(stageBlocks.length || spotlight || journey || glossary.length || contributions.length || role) },
  { id: 'result', label: 'Result', show: Boolean(data.results || cs?.snapshot.outcome || data.lessons.length) },
  { id: 'evidence', label: 'Evidence', show: gallery.length > 0 || press.length > 0 },
  { id: 'testimonial', label: 'Testimonial', show: testimonials.length > 0 },
  { id: 'enabled', label: 'What this enabled', show: Boolean(enabled) },
];
const shown = new Set(sections.filter((s) => s.show).map((s) => s.id));
// The closing CTA: the role story's own heading and link; case studies the homepage's
const cta = rs ? { heading: rs.cta.heading, label: rs.cta.link.label, href: rs.cta.link.href } : { heading: home.finalCta.heading, label: site.cta.label, href: site.cta.href };
---

<Base title={data.title} description={data.summary}>
  <ReadingProgress />

  <!-- 1. Snapshot -->
  <SubPageHeader
    id="snapshot"
    section="/ventures/"
    overviewLabel="Overview"
    title={experience?.company ?? data.title}
    intro={rs ? experience?.product : card?.line}
    facts={snapshotFacts}
    accent={deckItem?.color}
  >
    {
      logo && (
        <p class="venture-logos" slot="logos">
          <img src={logo.main.src} alt={logo.main.alt} width={logo.main.width} height={logo.main.height} class="venture-logo" />
          {logo.by && (
            <>
              <span class="venture-logos-by">by</span>
              <img src={logo.by.src} alt={logo.by.alt} width={logo.by.width} height={logo.by.height} class="venture-logo venture-logo-by" />
            </>
          )}
        </p>
      )
    }
    <div slot="after" class="snapshot-after">
      {
        keyNumbers.length > 0 && (
          <ul class="snapshot-metrics" aria-label="Key numbers">
            {keyNumbers.map((m) => (
              <li>
                <span class="snapshot-value">{m.value}</span> <span class="snapshot-label">{m.label}</span>
              </li>
            ))}
          </ul>
        )
      }
      <div class="snapshot-row">
        {cs && <p class="badge">Stage reached: {cs.snapshot.stage}</p>}
        {
          external && (
            <a href={external.href} class="btn btn-secondary" target="_blank" rel="noopener">
              {external.label} <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
  </SubPageHeader>

  <!-- 2. Visual: the live venture card, large and centred -->
  {
    deckItem && (
      <section id="visual" class="visual wrap" aria-labelledby="visual-heading" style={`--venture: var(--color-${deckItem.color})`}>
        <h2 id="visual-heading" class="sr-only">
          {data.title}, the live card
        </h2>
        <div class="venture-card" data-live-card>
          <DeckCard id={id}>
            <button type="button" class="deck-toggle" data-card-toggle aria-label={copy.cardPauseLabel} data-pause={copy.cardPauseLabel} data-play={copy.cardPlayLabel} hidden>
              <svg class="deck-icon-pause" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5.5 3.5v9M10.5 3.5v9" />
              </svg>
              <svg class="deck-icon-play" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M5 3.2v9.6L12.5 8z" />
              </svg>
            </button>
          </DeckCard>
        </div>
      </section>
    )
  }

  <div class="wrap venture">
    <nav class="toc" aria-label="On this page" data-toc>
      <p class="toc-title">On this page</p>
      <ol class="toc-list">
        {
          sections
            .filter((s) => s.show)
            .map((s) => (
              <li>
                <a href={`#${s.id}`} class="toc-link" data-toc-link={s.id}>
                  {s.label}
                </a>
              </li>
            ))
        }
      </ol>
    </nav>

    <div class="venture-body">
      <!-- 3. Challenge: the problem and the market; limitations -->
      {
        shown.has('challenge') && (
          <section id="challenge" class="block" aria-labelledby="challenge-heading" data-block data-reveal>
            <h2 id="challenge-heading" class="block-title">
              Challenge
            </h2>
            {about && (
              <>
                <p class="block-lead">{about.title}</p>
                <p class="block-text">{about.text}</p>
                {about.source && (
                  <p class="block-source">
                    <a href={about.source.href} class="link" target="_blank" rel="noopener">
                      {about.source.label}
                      <span class="sr-only"> (opens in a new tab)</span> ↗
                    </a>
                  </p>
                )}
              </>
            )}
            {pain && <p class="block-lead">{pain}</p>}
            {problemText && <p class="block-text">{problemText}</p>}
            {cs?.problem.source && (
              <p class="block-source">
                <a href={cs.problem.source.href} class="link" target="_blank" rel="noopener">
                  {cs.problem.source.label}
                  <span class="sr-only"> (opens in a new tab)</span> ↗
                </a>
              </p>
            )}
            {data.limitations.length > 0 && (
              <div id="limitations" class="sub">
                <h3 class="sub-title">Limitations and solutions</h3>
                <div class="mt-6">
                  <DataTable
                    caption="Limitations and solutions"
                    columns={[
                      { key: 'constraint', label: 'Constraint' },
                      { key: 'whyItMattered', label: 'Why it mattered' },
                      { key: 'tried', label: 'What we tried' },
                      { key: 'worked', label: 'What worked' },
                      { key: 'result', label: 'Result' },
                    ]}
                    rows={data.limitations}
                  />
                </div>
              </div>
            )}
          </section>
        )
      }

      <!-- 4. Contribution: what Raja did -->
      {
        shown.has('contribution') && (
          <section id="contribution" class="block" aria-labelledby="contribution-heading" data-block data-reveal>
            <h2 id="contribution-heading" class="block-title">
              Contribution
            </h2>

            {role && (
              <div id="what-i-did" class="sub">
                <h3 class="sub-title">What I did</h3>
                <ul class="block-bullets">
                  {role.bullets.map((bullet) => (
                    <li>{bulletText(bullet)}</li>
                  ))}
                </ul>
              </div>
            )}

            {cs && stageBlocks.length > 0 && (
              <div class="stages">
                <StageSpine reached={cs.snapshot.stage} anchors={['product-idea-fit', 'product-market-fit', 'scale']} />
                {stageBlocks.map((b) => (
                  <section id={b.id} class="stage" data-reached={b.reached || undefined} aria-labelledby={`${b.id}-heading`}>
                    <p class="stage-kicker">
                      <span class="stage-num" aria-hidden="true">
                        {b.number}
                      </span>
                      {b.question}
                      {b.reached && <span class="badge">Stage reached</span>}
                    </p>
                    <h3 id={`${b.id}-heading`} class="sub-title">
                      {b.name}
                    </h3>
                    <p class="block-text">{b.text}</p>
                    {b.stage.bullets.length > 0 && (
                      <ul class="block-bullets">
                        {b.stage.bullets.map((x) => (
                          <li>{x}</li>
                        ))}
                      </ul>
                    )}
                    {b.stage.source && (
                      <p class="block-source">
                        <a href={b.stage.source.href} class="link" target="_blank" rel="noopener">
                          {b.stage.source.label}
                          <span class="sr-only"> (opens in a new tab)</span> ↗
                        </a>
                      </p>
                    )}
                    {b.id === 'scale' && cs.verticals.length > 0 && (
                      <ul class="verticals" aria-label="Verticals entered">
                        {cs.verticals.map((v) => (
                          <li class="vertical">
                            <p class="vertical-name">{v.name}</p>
                            <p class="vertical-text">{v.text}</p>
                          </li>
                        ))}
                      </ul>
                    )}
                    {b.id === 'scale' && cs.clients && (
                      <p class="block-source">
                        {cs.clients.text}{' '}
                        <a href={cs.clients.source.href} class="link" target="_blank" rel="noopener">
                          {cs.clients.source.label}
                          <span class="sr-only"> (opens in a new tab)</span> ↗
                        </a>
                      </p>
                    )}
                  </section>
                ))}
              </div>
            )}

            {spotlight && (
              <section id="approvals" class="sub" aria-labelledby="approvals-heading">
                <h3 id="approvals-heading" class="sub-title">
                  {spotlight.heading}
                </h3>
                <p class="block-text">{spotlight.intro}</p>
                <div class="mt-6">
                  <DataTable
                    caption={spotlight.heading}
                    columns={[
                      { key: 'item', label: 'Item' },
                      { key: 'when', label: 'When' },
                      { key: 'means', label: 'What it means' },
                      { key: 'source', label: 'Source' },
                    ]}
                    rows={spotlight.rows.map((r) => ({
                      item: r.item,
                      when: r.when,
                      means: r.means,
                      source: r.source ? { label: hostname(r.source), href: r.source } : undefined,
                    }))}
                  />
                </div>
              </section>
            )}

            {journey && (
              <section id="journey" class="sub" aria-labelledby="journey-heading">
                <h3 id="journey-heading" class="sub-title">
                  {journey.heading}
                </h3>
                <div class="mt-6">
                  <JourneyFlow label={journey.heading} steps={journey.steps} goesLiveWith={journey.goesLiveWith} caption={journey.caption} />
                </div>
              </section>
            )}

            {glossary.length > 0 && (
              <section id="terms" class="sub terms" aria-labelledby="terms-heading">
                <h3 id="terms-heading" class="terms-title">
                  Terms used on this page
                </h3>
                <dl class="terms-list">
                  {glossary.map((g) => (
                    <div>
                      <dt>{g.term}:</dt> <dd>{g.definition}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}

            {contributions.length > 0 && (
              <section id="team" class="sub" aria-labelledby="team-heading">
                <h3 id="team-heading" class="sub-title">
                  Who did what
                </h3>
                <div class="mt-6">
                  <DataTable
                    caption="Who did what"
                    columns={[
                      { key: 'area', label: 'Area' },
                      { key: 'raja', label: 'Raja' },
                      { key: 'others', label: 'Team and partners' },
                    ]}
                    rows={contributions}
                  />
                </div>
              </section>
            )}
          </section>
        )
      }

      <!-- 5. Result -->
      {
        shown.has('result') && (
          <section id="result" class="block" aria-labelledby="result-heading" data-block data-reveal>
            <h2 id="result-heading" class="block-title">
              Result
            </h2>
            {cs?.snapshot.outcome && <p class="result-outcome">{cs.snapshot.outcome}</p>}
            {data.results && (
              <>
                <ul class="results-grid mt-8" data-count={data.results.tiles.length}>
                  {data.results.tiles.map((t) => (
                    <Counter value={t.value} label={t.label} />
                  ))}
                </ul>
                {data.results.definition && <p class="block-source">{data.results.definition}</p>}
              </>
            )}
            {data.lessons.length > 0 && (
              <div id="lessons" class="sub">
                <h3 class="sub-title">What I'd do differently</h3>
                <ul class="block-bullets">
                  {data.lessons.map((l) => (
                    <li>{l}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )
      }

      <!-- 6. Evidence: one gallery (product screens first), then press -->
      {
        shown.has('evidence') && (
          <section id="evidence" class="block" aria-labelledby="evidence-heading" data-block data-reveal>
            <h2 id="evidence-heading" class="block-title">
              Evidence
            </h2>
            {gallery.length > 0 && (
              <div class="mt-8">
                <Gallery
                  label={`${data.title}: product, events and MOUs`}
                  items={gallery}
                  columns="grid-cols-2 md:grid-cols-3"
                  sizes="(min-width: 1024px) 280px, (min-width: 768px) 33vw, 50vw"
                />
              </div>
            )}
            {press.length > 0 && (
              <div class="press">
                <h3 class="press-title">In the press</h3>
                <ul class="mt-3 flex flex-col gap-2">
                  {press.map((p) => (
                    <li>
                      <a href={p.href} class="link" target="_blank" rel="noopener">
                        {p.label}
                        <span class="sr-only"> (opens in a new tab)</span> ↗
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )
      }

      <!-- 7. Testimonial (site.json → testimonials for this venture) -->
      {
        shown.has('testimonial') && (
          <section id="testimonial" class="block" aria-labelledby="testimonial-heading" data-block data-reveal>
            <h2 id="testimonial-heading" class="block-title">
              Testimonial
            </h2>
            <ul class="mt-8 grid gap-4 md:grid-cols-2">
              {testimonials.map((t) => (
                <li>
                  <Testimonial testimonial={t} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- 8. What this enabled (a draft built only from facts on this page) -->
      {
        enabled && (
          <section id="enabled" class="block" aria-labelledby="enabled-heading" data-block data-reveal>
            <h2 id="enabled-heading" class="block-title">
              What this enabled
            </h2>
            <ul class="enabled-list">
              {enabled.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Next case study -->
      <section id="next" class="block next" aria-labelledby="next-heading" data-reveal>
        <h2 id="next-heading" class="next-kicker">{data.next && data.next.href !== '/ventures/other/' ? 'Next case study' : 'Next'}</h2>
        <div class="next-row">
          {
            data.next && (
              <ArrowLink href={data.next.href} class="next-link">
                {data.next.label}
              </ArrowLink>
            )
          }
        </div>
      </section>
    </div>
  </div>

  <!-- Closing call to action -->
  <CTA heading={cta.heading} label={cta.label} href={cta.href} />
</Base>

<style>
  /* The header's logo lockup: "AsaanBill · by Evamp & Saanga" on a light plate, so the logos' own
     colours always read */
  .venture-logos {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.25rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-control);
    background-color: #fff;
    color: #3d4450;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .venture-logo {
    display: block;
    width: auto;
    height: 1.75rem;
  }
  .venture-logo-by {
    height: 1.125rem;
  }
  .venture {
    padding-top: 1.5rem;
    padding-bottom: 1rem;
  }
  @media (width >= 64rem) {
    .venture {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
      padding-top: 1rem;
    }
  }
  .venture-body {
    min-width: 0;
  }

  /* On this page: desktop only */
  .toc {
    display: none;
  }
  @media (width >= 64rem) {
    .toc {
      position: sticky;
      top: 6.5rem;
      display: block;
    }
  }
  .toc-title {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    border-left: 1px solid var(--color-line);
  }
  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 1rem;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .toc-link:hover {
    color: var(--color-fg);
  }
  .toc-link[aria-current='true'] {
    color: var(--color-fg);
    border-left-color: var(--color-accent);
  }

  /* Blocks */
  .block {
    padding-top: 3.5rem;
    scroll-margin-top: 2.5rem; /* + the 3.5rem padding: the heading lands just below the header */
  }
  /* Blocks below the snapshot skip layout and paint until they come near the screen
     (lighter first load; see .defer-render in global.css). */
  .block:not(.snapshot) {
    content-visibility: auto;
    contain-intrinsic-size: auto 40rem;
  }
  :global(html:has(:target)) .block:not(.snapshot) {
    content-visibility: visible; /* an anchor jump renders everything, so it lands exactly */
  }
  @media print {
    .block:not(.snapshot) {
      content-visibility: visible;
    }
  }
  @media (width >= 64rem) {
    .block {
      padding-top: 4.5rem;
    }
  }
  .block-title {
    font-size: var(--text-display-md);
    line-height: var(--text-display-md--line-height);
    letter-spacing: var(--text-display-md--letter-spacing);
  }
  .block-lead {
    margin-top: 1rem;
    max-width: var(--container-prose);
    font-size: var(--text-lead);
    color: var(--color-fg);
  }
  .block-text {
    margin-top: 1rem;
    max-width: var(--container-prose);
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }
  .block-bullets {
    margin-top: 1rem;
    max-width: var(--container-prose);
