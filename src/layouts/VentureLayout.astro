---
/**
 * The venture page template, fed by one MDX file's frontmatter (schema:
 * src/content.config.ts). Two kinds share this look:
 * - kind: case-study (AsaanBill, TapitCard, Ladenza). Blocks, in order:
 *   snapshot · problem · product-idea-fit · product-market-fit · scale ·
 *   approvals · journey · terms · limitations · team · results · lessons ·
 *   evidence · next
 * - kind: role-story (Dressup, SonicEngine AI), built from one cv.json
 *   experience entry: the header carries Raja's role, dates and location; then
 *   product · what-i-did · problem · limitations · results · lessons ·
 *   evidence · next, and a closing call to action. No stage badge, no metric.
 * Each block has an anchor id and renders only when it has data.
 * A value that is still "TODO: …" counts as missing, so its block or field is
 * simply left out: no empty headings, no placeholders.
 * Desktop: a sticky "On this page" list of the rendered blocks.
 */
import Base from './Base.astro';
import SubPageHeader from '../components/SubPageHeader.astro';
import StageSpine from '../components/StageSpine.astro';
import JourneyFlow from '../components/JourneyFlow.astro';
import DataTable from '../components/DataTable.astro';
import Counter from '../components/Counter.astro';
import Gallery from '../components/Gallery.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import home from '../content/home.json';
import { site, filled } from '../lib/site';
import { bulletText, getExperience, roleDates } from '../lib/cv';
import { getRecognition, photosOf } from '../lib/recognition';
import { preSalesText, type CaseStudy, type RoleStory } from '../lib/ventures';

interface Props {
  id: string;
  data: CaseStudy | RoleStory;
}

const { id, data } = Astro.props;
const cs = data.kind === 'case-study' ? data : undefined;
const rs = data.kind === 'role-story' ? data : undefined;
const card = site.ventures.find((v) => v.id === id);

// Role story: everything about the role comes from cv.json → experience
const experience = rs ? getExperience(rs.experienceId) : undefined;
const role = experience?.roles[0];
const headerFacts = role
  ? [
      { label: 'Role', value: role.title },
      { label: 'Dates', value: roleDates(role) },
      { label: 'Location', value: filled(experience?.location) },
    ]
  : [];

// External link only once its href is real (Ladenza's Instagram is still a TODO)
const external = data.external && filled(data.external.href)?.startsWith('http') ? data.external : undefined;

// Stages (case studies), with the homepage playbook's question for each
const preSales = preSalesText(cs?.preSales);
const stageBlocks = cs
  ? [
      { id: 'product-idea-fit', name: 'Product-Idea Fit', stage: cs.stages.ideaFit },
      { id: 'product-market-fit', name: 'Product-Market Fit', stage: cs.stages.marketFit },
      { id: 'scale', name: 'Scale', stage: cs.stages.scale },
    ].map((b, i) => ({
      ...b,
      number: String(i + 1).padStart(2, '0'),
      question: home.playbook.stages.find((s) => s.id === b.id)?.question,
      text: preSales && b.stage.textWithPreSales ? b.stage.textWithPreSales.replace('{preSales}', preSales) : b.stage.text,
      reached: cs.snapshot.stage === b.name,
    }))
  : [];

const problemText = filled(data.problem?.text);
const pain = filled(cs?.problem.pain);
const spotlight = cs?.spotlight;
const journey = cs?.journey;
const glossary = cs?.glossary ?? [];
const contributions = cs?.contributions ?? [];
const press = cs?.press ?? [];
const evidence = data.evidenceIds.map(getRecognition).flatMap((item) => photosOf(item).map((p) => ({ image: p.file, caption: p.caption })));
const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, '');

const blocks = [
  { id: 'snapshot', label: 'Snapshot', show: Boolean(cs) },
  { id: 'product', label: 'The product', show: Boolean(rs) },
  { id: 'what-i-did', label: 'What I did', show: Boolean(role) },
  { id: 'problem', label: 'The problem', show: Boolean(problemText) },
  ...stageBlocks.map((b) => ({ id: b.id, label: b.name, show: Boolean(filled(b.text)) })),
  { id: 'approvals', label: 'Approvals', show: Boolean(spotlight) },
  { id: 'journey', label: 'Journey', show: Boolean(journey) },
  { id: 'terms', label: 'Terms', show: glossary.length > 0 },
  { id: 'limitations', label: 'Limitations', show: data.limitations.length > 0 },
  { id: 'team', label: 'Who did what', show: contributions.length > 0 },
  { id: 'results', label: 'Results', show: Boolean(data.results) },
  { id: 'lessons', label: 'Lessons', show: data.lessons.length > 0 },
  { id: 'evidence', label: 'Evidence', show: evidence.length > 0 || press.length > 0 },
  { id: 'next', label: 'Next', show: true },
];
const shown = new Set(blocks.filter((b) => b.show).map((b) => b.id));
---

<Base title={data.title} description={data.summary}>
  <ReadingProgress />
  <SubPageHeader
    section="/ventures/"
    overviewLabel="Overview"
    title={experience?.company ?? data.title}
    intro={rs ? experience?.product : card?.line}
    facts={headerFacts}
  />

  <div class="wrap venture">
    <nav class="toc" aria-label="On this page" data-toc>
      <p class="toc-title">On this page</p>
      <ol class="toc-list">
        {
          blocks
            .filter((b) => b.show)
            .map((b) => (
              <li>
                <a href={`#${b.id}`} class="toc-link" data-toc-link={b.id}>
                  {b.label}
                </a>
              </li>
            ))
        }
      </ol>
    </nav>

    <div class="venture-body">
      <!-- Snapshot -->
      {cs && (
      <section id="snapshot" class="block snapshot" aria-labelledby="snapshot-heading" data-block data-reveal>
        <div class="snapshot-top">
          <h2 id="snapshot-heading" class="snapshot-title">Snapshot</h2>
          <p class="badge">Stage reached: {cs.snapshot.stage}</p>
        </div>
        <dl class="snapshot-facts">
          <div>
            <dt>Role</dt>
            <dd>{cs.snapshot.role}</dd>
          </div>
          <div>
            <dt>Dates</dt>
            <dd>{cs.snapshot.dates}</dd>
          </div>
          {
            filled(cs.snapshot.team) && (
              <div>
                <dt>Team</dt>
                <dd>{cs.snapshot.team}</dd>
              </div>
            )
          }
        </dl>
        {
          cs.snapshot.metrics.length > 0 && (
            <ul class="snapshot-metrics">
              {cs.snapshot.metrics.map((m) => (
                <li>
                  <span class="snapshot-value">{m.value}</span> <span class="snapshot-label">{m.label}</span>
                </li>
              ))}
            </ul>
          )
        }
        <p class="snapshot-outcome">{cs.snapshot.outcome}</p>
        {
          external && (
            <a href={external.href} class="btn btn-secondary mt-6" target="_blank" rel="noopener">
              {external.label} <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )
        }
      </section>
      )}

      <!-- Role story: the product and what Raja did there (cv.json → experience) -->
      {
        rs && experience && (
          <section id="product" class="block snapshot" aria-labelledby="product-heading" data-block data-reveal>
            <h2 id="product-heading" class="block-title">
              The product
            </h2>
            {experience.product && <p class="block-lead">{experience.product}</p>}
            {experience.summary && <p class="block-text">{experience.summary}</p>}
            {external && (
              <a href={external.href} class="btn btn-secondary mt-6" target="_blank" rel="noopener">
                {external.label} <span aria-hidden="true">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </section>
        )
      }
      {
        rs && role && (
          <section id="what-i-did" class="block" aria-labelledby="what-i-did-heading" data-block data-reveal>
            <h2 id="what-i-did-heading" class="block-title">
              What I did
            </h2>
            <ul class="block-bullets">
              {role.bullets.map((bullet) => (
                <li>{bulletText(bullet)}</li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- The problem and the market -->
      {
        shown.has('problem') && (
          <section id="problem" class="block" aria-labelledby="problem-heading" data-block data-reveal>
            <h2 id="problem-heading" class="block-title">
              The problem and the market
            </h2>
            {pain && <p class="block-lead">{pain}</p>}
            <p class="block-text">{problemText}</p>
            {cs?.problem.source && (
              <p class="block-source">
                <a href={cs.problem.source.href} class="link" target="_blank" rel="noopener">
                  {cs.problem.source.label}
                  <span class="sr-only"> (opens in a new tab)</span> ↗
                </a>
              </p>
            )}
          </section>
        )
      }

      <!-- The three stages, on the Idea → Fit → Scale spine (case studies) -->
      {cs && (
      <div class="block stages">
        <StageSpine reached={cs.snapshot.stage} anchors={['product-idea-fit', 'product-market-fit', 'scale']} />
        {
          stageBlocks
            .filter((b) => shown.has(b.id))
            .map((b) => (
              <section id={b.id} class="stage" data-reached={b.reached || undefined} aria-labelledby={`${b.id}-heading`} data-block data-reveal>
                <p class="stage-kicker">
                  <span class="stage-num" aria-hidden="true">
                    {b.number}
                  </span>
                  {b.question}
                  {b.reached && <span class="badge">Stage reached</span>}
                </p>
                <h2 id={`${b.id}-heading`} class="block-title">
                  {b.name}
                </h2>
                <p class="block-text">{b.text}</p>
                {b.stage.bullets.length > 0 && (
                  <ul class="block-bullets">
                    {b.stage.bullets.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                )}
                {b.stage.source && (
                  <p class="block-source">
                    <a href={b.stage.source.href} class="link" target="_blank" rel="noopener">
                      {b.stage.source.label}
                      <span class="sr-only"> (opens in a new tab)</span> ↗
                    </a>
                  </p>
                )}

                {b.id === 'scale' && cs.verticals.length > 0 && (
                  <ul class="verticals" aria-label="Verticals entered">
                    {cs.verticals.map((v) => (
                      <li class="vertical">
                        <p class="vertical-name">{v.name}</p>
                        <p class="vertical-text">{v.text}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {b.id === 'scale' && cs.clients && (
                  <p class="block-source">
                    {cs.clients.text}{' '}
                    <a href={cs.clients.source.href} class="link" target="_blank" rel="noopener">
                      {cs.clients.source.label}
                      <span class="sr-only"> (opens in a new tab)</span> ↗
                    </a>
                  </p>
                )}
              </section>
            ))
        }
      </div>
      )}

      <!-- Payments and approvals spotlight (AsaanBill) -->
      {
        spotlight && (
          <section id="approvals" class="block" aria-labelledby="approvals-heading" data-block data-reveal>
            <h2 id="approvals-heading" class="block-title">
              {spotlight.heading}
            </h2>
            <p class="block-text">{spotlight.intro}</p>
            <div class="mt-8">
              <DataTable
                caption={spotlight.heading}
                columns={[
                  { key: 'item', label: 'Item' },
                  { key: 'when', label: 'When' },
                  { key: 'means', label: 'What it means' },
                  { key: 'source', label: 'Source' },
                ]}
                rows={spotlight.rows.map((r) => ({
                  item: r.item,
                  when: r.when,
                  means: r.means,
                  source: r.source ? { label: hostname(r.source), href: r.source } : undefined,
                }))}
              />
            </div>
          </section>
        )
      }

      <!-- Customer journey -->
      {
        journey && (
          <section id="journey" class="block" aria-labelledby="journey-heading" data-block data-reveal>
            <h2 id="journey-heading" class="block-title">
              {journey.heading}
            </h2>
            <div class="mt-8">
              <JourneyFlow label={journey.heading} steps={journey.steps} goesLiveWith={journey.goesLiveWith} caption={journey.caption} />
            </div>
          </section>
        )
      }

      <!-- Terms used on this page -->
      {
        glossary.length > 0 && (
          <section id="terms" class="block terms" aria-labelledby="terms-heading" data-block data-reveal>
            <h2 id="terms-heading" class="terms-title">
              Terms used on this page
            </h2>
            <dl class="terms-list">
              {glossary.map((g) => (
                <div>
                  <dt>{g.term}:</dt> <dd>{g.definition}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <!-- Limitations and solutions -->
      {
        data.limitations.length > 0 && (
          <section id="limitations" class="block" aria-labelledby="limitations-heading" data-block data-reveal>
            <h2 id="limitations-heading" class="block-title">
              Limitations and solutions
            </h2>
            <div class="mt-8">
              <DataTable
                caption="Limitations and solutions"
                columns={[
                  { key: 'constraint', label: 'Constraint' },
                  { key: 'whyItMattered', label: 'Why it mattered' },
                  { key: 'tried', label: 'What we tried' },
                  { key: 'worked', label: 'What worked' },
                  { key: 'result', label: 'Result' },
                ]}
                rows={data.limitations}
              />
            </div>
          </section>
        )
      }

      <!-- Who did what -->
      {
        contributions.length > 0 && (
          <section id="team" class="block" aria-labelledby="team-heading" data-block data-reveal>
            <h2 id="team-heading" class="block-title">
              Who did what
            </h2>
            <div class="mt-8">
              <DataTable
                caption="Who did what"
                columns={[
                  { key: 'area', label: 'Area' },
                  { key: 'raja', label: 'Raja' },
                  { key: 'others', label: 'Team and partners' },
                ]}
                rows={contributions}
              />
            </div>
          </section>
        )
      }

      <!-- Results -->
      {
        data.results && (
          <section id="results" class="block" aria-labelledby="results-heading" data-block data-reveal>
            <h2 id="results-heading" class="block-title">
              Results
            </h2>
            <ul class="results-grid mt-8" data-count={data.results.tiles.length}>
              {data.results.tiles.map((t) => (
                <Counter value={t.value} label={t.label} />
              ))}
            </ul>
            {data.results.definition && <p class="block-source">{data.results.definition}</p>}
          </section>
        )
      }

      <!-- What I'd do differently -->
      {
        data.lessons.length > 0 && (
          <section id="lessons" class="block" aria-labelledby="lessons-heading" data-block data-reveal>
            <h2 id="lessons-heading" class="block-title">
              What I'd do differently
            </h2>
            <ul class="block-bullets">
              {data.lessons.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Evidence -->
      {
        shown.has('evidence') && (
          <section id="evidence" class="block" aria-labelledby="evidence-heading" data-block data-reveal>
            <h2 id="evidence-heading" class="block-title">
              Evidence
            </h2>
            {evidence.length > 0 && (
              <div class="mt-8">
                <Gallery
                  label={`${data.title} evidence photos`}
                  items={evidence}
                  columns="grid-cols-2 md:grid-cols-3"
                  sizes="(min-width: 1024px) 280px, (min-width: 768px) 33vw, 50vw"
                />
              </div>
            )}
            {press.length > 0 && (
              <div class="press">
                <h3 class="press-title">In the press</h3>
                <ul class="mt-3 flex flex-col gap-2">
                  {press.map((p) => (
                    <li>
                      <a href={p.href} class="link" target="_blank" rel="noopener">
                        {p.label}
                        <span class="sr-only"> (opens in a new tab)</span> ↗
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )
      }

      <!-- Next venture and call to action -->
      <section id="next" class="block next" aria-labelledby="next-heading" data-block data-reveal>
        <h2 id="next-heading" class="next-kicker">{data.next ? 'Next venture' : 'Next'}</h2>
        <div class="next-row">
          {
            data.next && (
              <ArrowLink href={data.next.href} class="next-link">
                {data.next.label}
              </ArrowLink>
            )
          }
          {cs && <a href={site.cta.href} class="btn btn-primary">{site.cta.label}</a>}
        </div>
      </section>

      <!-- Role story: closing call to action -->
      {
        rs && (
          <section class="block role-cta" aria-labelledby="role-cta-heading" data-reveal>
            <h2 id="role-cta-heading" class="text-display-md">
              {rs.cta.heading}
            </h2>
            <ArrowLink href={rs.cta.link.href} class="text-lg">
              {rs.cta.link.label}
            </ArrowLink>
          </section>
        )
      }
    </div>
  </div>
</Base>

<style>
  .venture {
    padding-top: 2.5rem;
    padding-bottom: 1rem;
  }
  @media (width >= 64rem) {
    .venture {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
      padding-top: 3.5rem;
    }
  }
  .venture-body {
    min-width: 0;
  }

  /* On this page: desktop only */
  .toc {
    display: none;
  }
  @media (width >= 64rem) {
    .toc {
      position: sticky;
      top: 6.5rem;
      display: block;
    }
  }
  .toc-title {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    border-left: 1px solid var(--color-line);
  }
  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 1rem;
    border-left: 2px solid transparent;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .toc-link:hover {
    color: var(--color-fg);
  }
  .toc-link[aria-current='true'] {
    color: var(--color-fg);
    border-left-color: var(--color-accent);
  }

  /* Blocks */
  .block {
    padding-top: 3.5rem;
    scroll-margin-top: 2.5rem; /* + the 3.5rem padding: the heading lands just below the header */
  }
  /* Blocks below the snapshot skip layout and paint until they come near the screen
     (lighter first load; see .defer-render in global.css). */
  .block:not(.snapshot) {
    content-visibility: auto;
    contain-intrinsic-size: auto 40rem;
  }
  :global(html:has(:target)) .block:not(.snapshot) {
    content-visibility: visible; /* an anchor jump renders everything, so it lands exactly */
  }
  @media print {
    .block:not(.snapshot) {
      content-visibility: visible;
    }
  }
  @media (width >= 64rem) {
    .block {
      padding-top: 4.5rem;
    }
  }
  .block-title {
    font-size: var(--text-display-md);
    line-height: var(--text-display-md--line-height);
    letter-spacing: var(--text-display-md--letter-spacing);
  }
  .block-lead {
    margin-top: 1rem;
    max-width: var(--container-prose);
    font-size: var(--text-lead);
    color: var(--color-fg);
  }
  .block-text {
    margin-top: 1rem;
    max-width: var(--container-prose);
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }
  .block-bullets {
    margin-top: 1rem;
    max-width: var(--container-prose);
    padding-left: 1.125rem;
    list-style: disc;
    color: var(--color-fg-muted);
  }
  .block-source {
    margin-top: 1.25rem;
    max-width: var(--container-prose);
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
  }

  /* Snapshot card */
  .snapshot {
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }
  @media (width >= 48rem) {
    .snapshot {
      padding: 2.25rem;
    }
  }
  .snapshot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .snapshot-title {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .snapshot-facts {
    display: grid;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }
  @media (width >= 48rem) {
    .snapshot-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .snapshot-facts dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .snapshot-facts dd {
    margin-top: 0.125rem;
    color: var(--color-fg);
  }
  .snapshot-metrics {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-line);
  }
  @media (width >= 40rem) {
    .snapshot-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .snapshot-metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .snapshot-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
  .snapshot-label {
    color: var(--color-fg-muted);
  }
  .snapshot-outcome {
    margin-top: 1.75rem;
    max-width: 46rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.625rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }

  /* Stages */
  .stages {
    display: flex;
    flex-direction: column;
  }
  .stage {
    margin-top: 2.5rem;
    padding: 1.5rem 0 0 1.5rem;
    border-left: 2px solid var(--color-line);
  }
  .stage[data-reached] {
    border-left-color: var(--color-accent);
  }
  .stage-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-fg-muted);
  }
  .stage-num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }
