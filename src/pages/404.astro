---
import Base from '../layouts/Base.astro';
import Aurora from '../components/Aurora.astro';
import { site } from '../lib/site';
---

<Base title="Page not found" description="The page you were looking for doesn't exist or has moved. Go back to Raja Shaharyar Ali's homepage." noindex>
  <section class="band">
    <Aurora />
    <div class="wrap py-24 md:py-32">
      <p class="eyebrow">404</p>
      <h1 class="mt-4 text-display-lg">Page not found</h1>
      <p class="lead mt-6 max-w-xl">The page you were looking for doesn't exist or has moved.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href={site.cta.href} class="btn btn-secondary">{site.cta.label}</a>
      </div>
    </div>
  </section>
</Base>
