---
/**
 * About ▾ Beyond work (/about/beyond-work): NGO Mustahiq and the K2 trek,
 * two lines and two photos each.
 * Copy: about.json → beyondWork · photos and captions: images.json
 */
import Base from '../../layouts/Base.astro';
import AboutHeader from '../../components/AboutHeader.astro';
import Gallery from '../../components/Gallery.astro';
import { about } from '../../lib/about';

const { beyondWork: page } = about;
---

<Base title={page.title} description={page.description} ogType="profile">
  <AboutHeader title={page.title} />

  {
    page.sections.map((section, i) => (
      <section
        id={section.id}
        class:list={[
          'wrap',
          i === 0 ? 'pt-10 md:pt-14' : 'border-t border-line pt-16 md:pt-24',
          i === page.sections.length - 1 ? 'pb-4' : 'pb-16 md:pb-24',
        ]}
        aria-labelledby={`${section.id}-heading`}
      >
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <h2 id={`${section.id}-heading`} class="text-display-md">
              {section.heading}
            </h2>
            <p class="lead mt-5 max-w-prose">{section.text}</p>
          </div>
          <div class="lg:col-span-7">
            <Gallery label={section.label} items={section.images.map((image) => ({ image }))} columns="grid-cols-1 sm:grid-cols-2" />
          </div>
        </div>
      </section>
    ))
  }
</Base>
