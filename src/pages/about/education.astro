---
/**
 * About ▾ Education (/about/education): the degree card, courses and
 * programmes, on-campus involvement and a closing line.
 * Copy: about.json → education · facts (degree, programmes): cv.json
 * Missing data (a "TODO" in cv.json) is hidden, never shown.
 */
import Base from '../../layouts/Base.astro';
import AboutHeader from '../../components/AboutHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Gallery from '../../components/Gallery.astro';
import { about } from '../../lib/about';
import { getEducation, getProgramme } from '../../lib/cv';
import { formatMonth, formatRange, isIsoDate } from '../../lib/dates';
import { filled } from '../../lib/site';

const { education: page } = about;
const degree = getEducation(page.degree.cvId);

const programmes = page.programmes.cvIds
  .map(getProgramme)
  .filter((p) => isIsoDate(p.start))
  .sort((a, b) => a.start.localeCompare(b.start) || (a.end ?? '9999').localeCompare(b.end ?? '9999'))
  .map((p) => ({
    ...p,
    title: p.mode ? `${p.name}, ${p.mode}` : p.name,
    dates: formatRange(p.start, isIsoDate(p.end) ? p.end : null),
    covered: filled(p.covered),
    certificate: filled(p.certificate),
    image: filled(p.image),
  }));

const sectionY = 'py-16 md:py-24';
---

<Base title={page.title} description={page.description} ogType="profile">
  <AboutHeader title={page.title} intro={page.intro} />

  <!-- Degree -->
  <section class="wrap pt-10 pb-16 md:pt-14 md:pb-24" aria-labelledby="degree-heading">
    <article class="rounded-card border border-line bg-surface p-6 sm:p-8 md:p-10">
      <h2 id="degree-heading" class="text-display-md">{degree.degree}</h2>
      <p class="mt-3 text-lg text-fg-muted">
        <span class="whitespace-nowrap">{degree.institution}, {degree.city}</span>{' '}
        <span aria-hidden="true" class="px-1 text-fg-subtle">·</span>{' '}
        <span class="whitespace-nowrap"
          ><time datetime={degree.start}>{formatMonth(degree.start)}</time>{' – '}<time datetime={degree.end}
            >{formatMonth(degree.end)}</time
          ></span
        >
      </p>
      <div class="mt-8 max-w-prose border-t border-line pt-6">
        <h3 class="text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">{page.degree.fypLabel}</h3>
        <p class="mt-3 text-lg leading-relaxed">{page.degree.fyp}</p>
      </div>
      <div class="mt-10">
        <Gallery
          label={page.degree.label}
          items={page.degree.images.map((image) => ({ image }))}
          columns="grid-cols-2 lg:grid-cols-4"
        />
      </div>
    </article>
  </section>

  <!-- Courses and programmes -->
  <section class:list={['wrap border-t border-line', sectionY]} aria-labelledby="programmes-heading">
    <SectionHeader id="programmes-heading" heading={page.programmes.heading} />
    <ol class="mt-10 flex flex-col gap-4 md:mt-12">
      {
        programmes.map((p) => (
          <li class="programme rounded-card border border-line bg-surface p-6 sm:p-8">
            <div class="flex flex-col gap-2">
              <p class="text-sm font-semibold tracking-[0.06em] text-accent uppercase">{p.provider}</p>
              <h3 class="text-2xl md:text-[1.75rem]">{p.title}</h3>
              <p class="text-fg-muted">{p.dates}</p>
              {p.covered && (
                <p class="mt-2 max-w-prose">
                  <span class="text-fg-subtle">{page.programmes.coveredLabel}: </span>
                  {p.covered}
                </p>
              )}
              {p.certificate && (
                <a href={p.certificate} class="arrow-link mt-2 w-fit">
                  {page.programmes.certificateLabel}
                  <span class="sr-only">: {p.title}</span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              )}
            </div>
            {p.image && (
              <div class="programme-photo">
                <Gallery label={`${p.provider} photo`} items={[{ image: p.image }]} columns="grid-cols-1" aspect="aspect-[4/5]" />
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <!-- On campus -->
  <section class:list={['wrap border-t border-line', sectionY]} aria-labelledby="campus-heading">
    <SectionHeader id="campus-heading" heading={page.campus.heading} />
    <div class="mt-10 md:mt-12">
      <Gallery
        label={page.campus.label}
        items={page.campus.items.map((item) => ({ image: item.image, caption: item.text }))}
        columns="grid-cols-1 sm:grid-cols-2 lg:grid-cols-4"
      />
    </div>
  </section>

  <!-- What it gave me (draft wording, see about.json) -->
  <section class="wrap border-t border-line pt-16 pb-4 md:pt-24" aria-label="What it gave me">
    <p class="pull-line max-w-3xl">{page.closing.text}</p>
  </section>
</Base>

<style>
  .programme {
    display: grid;
    gap: 1.5rem;
  }
  @media (width >= 40rem) {
    .programme:has(.programme-photo) {
      grid-template-columns: 1fr 10rem;
      align-items: start;
    }
  }
  @media (width >= 64rem) {
    .programme:has(.programme-photo) {
      grid-template-columns: 1fr 11rem;
    }
  }
</style>
