---
/**
 * My story (/about/): the first of the three About pages (Phase 17), each in the About dropdown with the CV.
 *   intro (the story) · #career · #recognition · #along-the-way · call to action
 * The other two: /about/education/ (degree, courses, distinctions) and /about/beyond-work/ (Mustahiq, K2,
 * speaking). One H1 per page, an H2 per section. Old anchors from the one-page About (#education, #courses,
 * #distinctions, #beyond-work, #speaking) are sent on to their new page by the small script below.
 * Copy: about.json · CV facts: cv.json · wins and counters: recognition.json (+ recognition-pages.json)
 * · photos and captions: images.json
 */
import Base from '../../layouts/Base.astro';
import SubPageHeader from '../../components/SubPageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Timeline from '../../components/Timeline.astro';
import Gallery from '../../components/Gallery.astro';
import Counter from '../../components/Counter.astro';
import Media from '../../components/Media.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import CTA from '../../components/CTA.astro';
import home from '../../content/home.json';
import { about, buildTimeline } from '../../lib/about';
import { badgeText, getRecognition, photosOf } from '../../lib/recognition';
import { badgeCounter, pageFor, recognitionCopy } from '../../lib/recognition-pages';
import { site } from '../../lib/site';

const { story } = about;
const page = about.page.story;
const timeline = buildTimeline();

// Recognition: the /recognition counters, then up to 6 wins that have a photo
const counters = recognitionCopy.overview.counters.map((c) => badgeCounter(c.badge));
const wins = home.recognition.slides
  .map(getRecognition)
  .filter((item) => (item.badge === 'Winner' || item.badge === 'Top 3') && photosOf(item).length > 0)
  .slice(0, about.recognition.maxHighlights)
  .map((item) => ({ ...item, photo: photosOf(item)[0], href: `${pageFor(item.badge)}#${item.id}`, badge: badgeText(item) }));
const recognitionPages = site.recognitionMenu.children;

const sectionY = 'py-16 md:py-24';
---

<Base title={page.title} description={page.description} ogType="profile">
  <SubPageHeader section="/about/" title={page.title} />

  <!-- 1. The story -->
  <section id="intro" class="wrap pt-10 pb-16 md:pt-14 md:pb-24" aria-label={page.title}>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="story flex flex-col gap-6 lg:col-span-7">
        {story.paragraphs.map((text) => <p>{text}</p>)}
      </div>
      <p class="pull-line lg:col-span-5 lg:self-end">{story.closing}</p>
    </div>
  </section>

  <!-- 2. Career timeline -->
  <section id="career" class:list={['wrap border-t border-line', sectionY, 'defer-render']} aria-labelledby="career-heading">
    <SectionHeader id="career-heading" heading={story.timeline.heading} />
    <div class="mt-10 md:mt-12">
      <Timeline items={timeline} />
    </div>
  </section>

  <!-- 3. Recognition: counters, wins with photos, the four detail pages -->
  <section id="recognition" class:list={['band band-deep', sectionY, 'defer-render']} aria-labelledby="recognition-heading">
    <div class="wrap">
      <SectionHeader id="recognition-heading" heading={about.recognition.heading} />
      <ul
        class="counters-deep mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-card border md:mt-12 md:grid-cols-3 lg:grid-cols-6"
        aria-label={recognitionCopy.overview.countersLabel}
        data-reveal-stagger="inner"
      >
        {counters.map((c) => <Counter value={c.value} label={c.label} />)}
      </ul>

      <h3 class="mt-12 text-xl font-semibold tracking-tight">{about.recognition.highlightsLabel}</h3>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-reveal-stagger>
        {
          wins.map((w) => (
            <li class="win lift-card" data-spotlight>
              <Media image={w.photo.file} fit="contain" sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="card-media-top aspect-[4/3] border-b border-line" />
              <div class="flex flex-1 flex-col gap-2 p-5">
                {w.badge && <p class="badge w-fit">{w.badge}</p>}
                <h4 class="mt-1 text-lg leading-snug font-semibold">
                  <a href={w.href} class="win-link">
                    {w.title}
                  </a>
                </h4>
                <p class="text-sm text-fg-muted">{w.date}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <ul class="recognition-pages mt-10">
        {
          recognitionPages.map((p) => (
            <li>
              <ArrowLink href={p.href}>{p.label}</ArrowLink>
              {p.description && <p class="text-sm text-fg-muted">{p.description}</p>}
            </li>
          ))
        }
      </ul>
      <ArrowLink href={about.recognition.allLink.href} class="mt-6">{about.recognition.allLink.label}</ArrowLink>
    </div>
  </section>

  <!-- 4. Along the way: the photos of the year in date order (was "2024 in review"), on near-black -->
  <section id="along-the-way" class:list={['wrap', sectionY, 'defer-render']} aria-labelledby="along-the-way-heading">
    <SectionHeader id="along-the-way-heading" heading={story.alongTheWay.heading} />
    <div class="mt-10 md:mt-12">
      <Gallery
        label={story.alongTheWay.label}
        items={story.alongTheWay.images.map((image) => ({ image }))}
        columns="grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
        sizes="(min-width: 1024px) 280px, (min-width: 768px) 33vw, 50vw"
      />
    </div>
  </section>

  <!-- 5. Call to action -->
  <CTA heading={page.cta.heading} label={page.cta.label} href={page.cta.href} />
</Base>

<script is:inline>
  // Links to the old one-page About (e.g. /about/#education) land on the section's new page.
  (function () {
    var moved = {
      '#education': '/about/education/',
      '#courses': '/about/education/#courses',
      '#distinctions': '/about/education/#distinctions',
      '#beyond-work': '/about/beyond-work/',
      '#mustahiq': '/about/beyond-work/#mustahiq',
      '#k2': '/about/beyond-work/#k2',
      '#speaking': '/about/beyond-work/#speaking',
      '#review-2024': '/about/#along-the-way',
    };
    var to = moved[location.hash];
    if (to) location.replace(to);
  })();
</script>

<style>
  .story p {
    max-width: var(--container-prose);
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }
  .story p:first-child {
    color: var(--color-fg);
  }
  .win {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid rgb(167 139 250 / 0.24);
    border-radius: var(--radius-card);
    background-color: color-mix(in oklab, var(--color-accent-2-deep) 82%, var(--color-accent-2-strong));
  }
  .win-link {
    text-decoration: none;
  }
  .win-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .win-link:focus-visible {
    outline: none;
  }
  .win-link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .recognition-pages {
    display: grid;
    gap: 1rem 2rem;
  }
  @media (width >= 48rem) {
    .recognition-pages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
