---
/**
 * About ▾ My story (/about): the story, a career timeline and 2024 in review.
 * Copy: src/content/about.json → story · timeline extras: cv.json → experience
 * Photos and captions: images.json
 */
import Base from '../../layouts/Base.astro';
import AboutHeader from '../../components/AboutHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Timeline from '../../components/Timeline.astro';
import Gallery from '../../components/Gallery.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { about, buildTimeline } from '../../lib/about';

const { story } = about;
const timeline = buildTimeline();
const sectionY = 'py-16 md:py-24';
---

<Base title={story.title} description={story.description} ogType="profile">
  <AboutHeader title={story.title} />

  <!-- The story -->
  <section class="wrap pt-8 pb-16 md:pt-10 md:pb-24" aria-label="The story">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="story flex flex-col gap-6 lg:col-span-7">
        {story.paragraphs.map((text) => <p>{text}</p>)}
      </div>
      <p class="pull-line lg:col-span-5 lg:self-end">{story.closing}</p>
    </div>
  </section>

  <!-- Career timeline -->
  <section id="timeline" class:list={['wrap border-t border-line', sectionY, 'defer-render']} aria-labelledby="timeline-heading">
    <SectionHeader id="timeline-heading" heading={story.timeline.heading} />
    <div class="mt-10 md:mt-12">
      <Timeline items={timeline} />
    </div>
  </section>

  <!-- 2024 in review -->
  <section id="review-2024" class:list={['wrap border-t border-line', sectionY, 'defer-render']} aria-labelledby="review-heading">
    <SectionHeader id="review-heading" heading={story.review.heading} />
    <div class="mt-10 md:mt-12">
      <Gallery
        label={story.review.label}
        items={story.review.images.map((image) => ({ image }))}
        columns="grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
        sizes="(min-width: 1024px) 280px, (min-width: 768px) 33vw, 50vw"
      />
    </div>
  </section>

  <!-- Where next -->
  <section class="wrap border-t border-line pt-12 pb-4 md:pt-16" aria-label="Where next">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-5">
      <ArrowLink href={story.links.next.href} class="text-lg">{story.links.next.label}</ArrowLink>
      <a href={story.links.cta.href} class="btn btn-primary">{story.links.cta.label}</a>
    </div>
  </section>
</Base>

<style>
  .story p {
    max-width: var(--container-prose);
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-fg-muted);
  }
  .story p:first-child {
    color: var(--color-fg);
  }
</style>
