---
/**
 * About ▾ Skills & tools (/about/skills): how I work (principle + proof),
 * the toolkit as grouped chips (no percentage bars or ratings) and languages.
 * Copy: about.json → skills · toolkit and languages: cv.json
 */
import Base from '../../layouts/Base.astro';
import AboutHeader from '../../components/AboutHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { about } from '../../lib/about';
import { cv } from '../../lib/cv';

const { skills: page } = about;
const groups = cv.skills.groups;
const languages = cv.languages.items;
const sectionY = 'py-16 md:py-24';
---

<Base title={page.title} description={page.description} ogType="profile">
  <AboutHeader title={page.title} />

  <!-- How I work -->
  <section class="wrap pt-10 pb-16 md:pt-14 md:pb-24" aria-labelledby="how-heading">
    <SectionHeader id="how-heading" heading={page.howIWork.heading} />
    <ol class="mt-10 grid gap-4 sm:grid-cols-2 md:mt-12 lg:gap-6" data-reveal-stagger>
      {
        page.howIWork.items.map((item, i) => (
          <li class="flex flex-col rounded-card border border-line bg-surface p-6 md:p-8">
            <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 font-display text-2xl leading-tight font-semibold tracking-tight md:text-[1.75rem]">
              {item.principle}
            </h3>
            <div class="mt-6 border-t border-line pt-5">
              <p class="text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">{page.howIWork.proofLabel}</p>
              <p class="mt-2 text-fg-muted">{item.proof}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Toolkit -->
  <section class:list={['wrap border-t border-line', sectionY]} aria-labelledby="toolkit-heading">
    <SectionHeader id="toolkit-heading" heading={page.toolkit.heading} />
    <div class="mt-10 grid gap-10 md:mt-12 md:grid-cols-3 md:gap-8">
      {
        groups.map((group) => (
          <div>
            <h3 class="text-xl font-semibold tracking-tight">{group.name}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((tool) => (
                <li class="chip">{tool}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Languages -->
  <section class="wrap border-t border-line pt-16 pb-4 md:pt-24" aria-labelledby="languages-heading">
    <SectionHeader id="languages-heading" heading={page.languages.heading} />
    <ul class="mt-8 flex flex-wrap gap-4">
      {
        languages.map((lang) => (
          <li class="flex min-w-48 items-baseline justify-between gap-6 rounded-card border border-line bg-surface px-6 py-5">
            <span class="font-display text-2xl font-semibold tracking-tight">{lang.name}</span>
            <span class="text-fg-muted">{lang.level}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

