---
/**
 * Let's talk (/contact/), in the sitemap's order: What's this about? (the
 * reason picker: Growth help / Speaking / Other) · Your details (name,
 * email, phone or WhatsApp, company) · Message and send · Contact details (the
 * direct channels: beside the form on wide screens, after it on phones).
 *
 * ── HOW THE FORM SENDS (site.json → contact.form) ────────────────────────
 * provider "web3forms": posts to Web3Forms, which emails Raja at the address
 *   the access key belongs to, with Reply-To set to the sender's email.
 *   With JavaScript the form sends with fetch (JSON) and shows a confirmation
 *   or an error with fallbacks; without JavaScript it posts normally and
 *   Web3Forms redirects to /contact/thanks/.
 * provider "formspree": the same, through Formspree.
 * provider "" (default until a key is added): the form opens the visitor's
 *   email app with the message ready to send (mailto).
 * ─────────────────────────────────────────────────────────────────────────
 *
 * Pre-select a reason from a link: /contact/?reason=growth-help|speaking|other
 * (?reason=hiring, from older links, preselects Other). Wording: src/content/contact.json.
 */
import Base from '../layouts/Base.astro';
import { site, filled } from '../lib/site';
import copy from '../content/contact.json';

const { contact } = site;
const { provider } = contact.form;
const web3formsKey = filled(contact.form.web3formsKey);
const formspreeId = filled(contact.form.formspreeId);
// Only switch to a provider when its key is really there.
const mode = provider === 'web3forms' && web3formsKey ? 'web3forms' : provider === 'formspree' && formspreeId ? 'formspree' : 'mailto';
// Email-app mode has no form action: a mailto: action is an insecure form target, so the
// script opens the email app instead (without JavaScript the button stays disabled).
const action = mode === 'web3forms' ? 'https://api.web3forms.com/submit' : mode === 'formspree' ? `https://formspree.io/f/${formspreeId}` : undefined;
const thanksUrl = new URL('/contact/thanks/', site.url).href;
const serviceName = mode === 'web3forms' ? 'Web3Forms' : 'Formspree';

const reasons = copy.reasons.map((r) => ({ ...r, aliases: 'aliases' in r ? r.aliases?.join(' ') : undefined }));

const title = "Let's talk";
const description = copy.description;
---

<Base title="Contact" description={description} hideDock>
  <section class="wrap py-16 md:py-24">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-4 text-display-lg">{title}</h1>
    <p class="lead mt-6 max-w-2xl">
      Tell me what you're working on. Pick a reason so your message reaches the right conversation.
    </p>

    <div class="mt-14 grid gap-14 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-20">
      <div>
        <!-- Form -->
        <form
          class="contact-form"
          action={action}
          method="post"
          data-contact-form
          data-mode={mode}
          data-email={contact.email}
          data-whatsapp={contact.whatsapp.href}
        >
          <fieldset data-field="reason">
            <legend class="field-label">What's this about?</legend>
            <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
              {
                reasons.map((r, i) => (
                  <label class="reason">
                    <input type="radio" name="reason" value={r.label} data-reason={r.value} data-aliases={r.aliases} required={i === 0} />
                    <span class="flex flex-col">
                      <span class="font-semibold">{r.label}</span>
                      <span class="text-sm text-fg-muted">{r.hint}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="field-error" id="cf-reason-error" data-error-for="reason" hidden></p>
          </fieldset>

          <fieldset class="mt-8">
            <legend class="field-label">Your details</legend>
          <div class="mt-3 grid gap-6 sm:grid-cols-2">
            <div data-field="name">
              <label for="cf-name" class="field-label">Your name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required class="field" />
              <p class="field-error" id="cf-name-error" data-error-for="name" hidden></p>
            </div>
            <div data-field="email">
              <label for="cf-email" class="field-label">Your email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required class="field" />
              <p class="field-error" id="cf-email-error" data-error-for="email" hidden></p>
            </div>
            <div data-field="phone">
              <label for="cf-phone" class="field-label">Phone or WhatsApp <span class="field-optional">(optional)</span></label>
              <input
                id="cf-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="field"
                aria-describedby="cf-phone-hint"
              />
              <p class="field-hint" id="cf-phone-hint">Optional, if you'd rather talk on WhatsApp</p>
            </div>
            <div data-field="company">
              <label for="cf-company" class="field-label">Company or organisation <span class="field-optional">(optional)</span></label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" class="field" />
            </div>
          </div>
          </fieldset>

          <div class="mt-6" data-field="message">
            <label for="cf-message" class="field-label">Message</label>
            <textarea id="cf-message" name="message" rows="6" required class="field resize-y"></textarea>
            <p class="field-error" id="cf-message-error" data-error-for="message" hidden></p>
          </div>

          {
            mode === 'web3forms' && (
              <>
                <input type="hidden" name="access_key" value={web3formsKey} />
                <input type="hidden" name="subject" value={`Website enquiry from ${new URL(site.url).host}`} data-subject />
                <input type="hidden" name="from_name" value={new URL(site.url).host} />
                <input type="hidden" name="page" value="" data-page />
                <input type="hidden" name="redirect" value={thanksUrl} />
              </>
            )
          }
          {mode === 'formspree' && <input type="hidden" name="_subject" value={`Website enquiry from ${new URL(site.url).host}`} data-subject />}
          {
            mode !== 'mailto' && (
              /* Honeypot: people never see or reach it; a bot that ticks it gets a fake success */
              <div class="hp" aria-hidden="true">
                <label>
                  Leave this box unticked <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" data-botcheck />
                </label>
              </div>
            )
          }

          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
            <button type="submit" class="btn btn-primary sm:w-auto" data-submit disabled={mode === 'mailto'}>Send message</button>
            {mode === 'mailto' && <p class="text-sm text-fg-muted">This opens your email app with the message ready to send.</p>}
            {
              mode === 'mailto' && (
                <noscript>
                  <p class="text-sm text-fg-muted">
                    This form needs JavaScript. Email <a href={`mailto:${contact.email}`} class="link">{contact.email}</a> directly instead.
                  </p>
                </noscript>
              )
            }
          </div>
          {
            mode !== 'mailto' && (
              <p class="mt-4 text-sm text-fg-muted">
                Your message is emailed to Raja through {serviceName}. Your details aren't used for anything else.
              </p>
            )
          }
          <div class="form-alert mt-6" role="alert" data-form-error hidden></div>
          <p class="mt-4 text-sm text-fg-muted" role="status" aria-live="polite" data-form-status></p>
        </form>

        <!-- Shown in place of the form once a message has been sent -->
        <div class="form-done" tabindex="-1" data-form-done hidden>
          <h2 class="text-display-md">Message sent</h2>
          <p class="lead mt-4" data-done-text></p>
          <button type="button" class="btn btn-secondary mt-8" data-send-another>Send another message</button>
        </div>
      </div>

      <!-- Direct channels -->
      <aside aria-labelledby="direct-heading">
        <h2 id="direct-heading" class="text-display-md">Or reach me directly</h2>
        <ul class="mt-6 flex flex-col gap-3">
          <li>
            <a href={`mailto:${contact.email}`} class="channel">
              <span class="channel-key">Email</span>
              <span class="channel-value break-all">{contact.email}</span>
            </a>
          </li>
          <li>
            <a href={contact.whatsapp.href} class="channel">
              <span class="channel-key">WhatsApp</span>
              <span class="channel-value">{contact.whatsapp.display}</span>
            </a>
          </li>
          <li>
            <a href={contact.linkedin.href} class="channel">
              <span class="channel-key">LinkedIn</span>
              <span class="channel-value">{site.name}</span>
            </a>
          </li>
          {
            /* Hidden until site.json → contact.booking.href is filled in */
            contact.booking.href && (
              <li>
                <a href={contact.booking.href} class="channel">
                  <span class="channel-key">Book a call</span>
                  <span class="channel-value">Pick a time</span>
                </a>
              </li>
            )
          }
        </ul>
        <p class="mt-6 text-fg-muted">Based in {site.location.display}.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .field-label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-fg);
  }
  .field-optional {
    font-weight: 400;
    color: var(--color-fg-muted);
  }
  .field {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    min-height: 2.875rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    color: var(--color-fg);
    font: inherit;
    transition: border-color 0.15s;
  }
  .field:hover {
    border-color: var(--color-fg-subtle);
  }
  .field:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }
  .field[aria-invalid='true'] {
    border-color: #ff8f8f;
  }
  .field-hint {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
  .field-error {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #ffb4b4;
  }
  .field-error[hidden] {
    display: none;
  }

  .reason {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    background-color: var(--color-surface);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .reason:hover {
    border-color: var(--color-fg-subtle);
  }
  .reason:has(input:checked) {
    border-color: var(--color-accent);
    background-color: var(--color-raised);
  }
  .reason input {
    appearance: none;
    flex-shrink: 0;
    display: grid;
    place-content: center;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.25rem;
    border: 1.5px solid var(--color-line-strong);
    border-radius: 999px;
    cursor: pointer;
  }
  .reason input::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background-color: var(--color-accent-ink);
    transform: scale(0);
    transition: transform 0.12s var(--ease-out-quart);
  }
  .reason input:checked {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .reason input:checked::before {
    transform: scale(1);
  }

  /* Honeypot: off-screen, out of the tab order and hidden from screen readers */
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  button[data-submit][disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .form-alert {
    padding: 1rem 1.125rem;
    border: 1px solid #ff8f8f;
    border-radius: var(--radius-control);
    background-color: color-mix(in srgb, #ff8f8f 8%, var(--color-surface));
    color: var(--color-fg);
  }
  .form-alert[hidden] {
    display: none;
  }
  .form-alert :global(a) {
    color: var(--color-fg);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .form-alert :global(ul) {
    margin-top: 0.5rem;
    padding-left: 1.125rem;
    list-style: disc;
  }

  .form-done {
    padding: 2rem 1.75rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }
  .form-done[hidden] {
    display: none;
  }
  .form-done:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  a.channel:hover {
    border-color: var(--color-accent);
  }
  .channel-key {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .channel-value {
    font-weight: 500;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const done = document.querySelector<HTMLElement>('[data-form-done]');

  if (form && done) {
    const mode = form.dataset.mode ?? 'mailto';
    const to = form.dataset.email ?? '';
    const whatsapp = form.dataset.whatsapp ?? '';
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const alertBox = form.querySelector<HTMLElement>('[data-form-error]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = submit?.textContent ?? 'Send message';
    const doneText = done.querySelector<HTMLElement>('[data-done-text]');
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;

    // Pre-select a reason from ?reason=growth-help|speaking|other (or an old alias: hiring → Other)
    const wanted = new URLSearchParams(window.location.search).get('reason');
    if (wanted) {
      const v = CSS.escape(wanted);
      const radio = form.querySelector<HTMLInputElement>(`input[data-reason="${v}"], input[data-aliases~="${v}"]`);
      if (radio) radio.checked = true;
    }
    // Email-app mode ships the button disabled (it needs this script); switch it on.
    if (mode === 'mailto' && submit) submit.disabled = false;

    // The page the visitor came from, if the browser tells us
    const pageField = form.querySelector<HTMLInputElement>('[data-page]');
    if (pageField) pageField.value = document.referrer;

    // Our own validation messages, next to each field
    form.noValidate = true;
    const rules: [string, (v: string) => string][] = [
      ['reason', (v) => (v ? '' : 'Please pick what this is about.')],
      ['name', (v) => (v.trim() ? '' : 'Please enter your name.')],
      [
        'email',
        (v) =>
          !v.trim() ? 'Please enter your email, so Raja can reply.' : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Please enter a valid email address, like name@example.com.',
      ],
      ['message', (v) => (v.trim() ? '' : 'Please write a message.')],
    ];
    const showError = (name: string, message: string) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = name === 'reason' ? form.querySelector<HTMLInputElement>('input[name="reason"]') : field(name);
      if (error) {
        error.textContent = message;
        error.hidden = !message;
      }
      const targets = name === 'reason' ? Array.from(form.querySelectorAll<HTMLInputElement>('input[name="reason"]')) : input ? [input] : [];
      for (const t of targets) {
        if (message) {
          t.setAttribute('aria-invalid', 'true');
          t.setAttribute('aria-describedby', `cf-${name}-error`);
        } else {
          t.removeAttribute('aria-invalid');
          if (name !== 'phone') t.removeAttribute('aria-describedby');
        }
      }
    };
    const validate = () => {
      const data = new FormData(form);
      let firstBad: string | null = null;
      for (const [name, rule] of rules) {
        const message = rule(String(data.get(name) ?? ''));
        showError(name, message);
        if (message && !firstBad) firstBad = name;
      }
      if (firstBad) {
        const el = firstBad === 'reason' ? form.querySelector<HTMLInputElement>('input[name="reason"]') : field(firstBad);
        el?.focus();
      }
      return !firstBad;
    };
    // Clear a field's message as soon as it's fixed
    form.addEventListener('input', (e) => {
      const name = (e.target as HTMLInputElement).name;
      const rule = rules.find(([n]) => n === name)?.[1];
      if (rule && form.querySelector(`[data-error-for="${name}"]:not([hidden])`)) showError(name, rule(String(new FormData(form).get(name) ?? '')));
    });

    const values = () => {
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      return { reason: get('reason') || 'Other', name: get('name'), email: get('email'), phone: get('phone'), company: get('company'), message: get('message') };
    };
    const mailtoHref = (v: ReturnType<typeof values>) => {
      const subject = `Website enquiry: ${v.reason} from ${v.name}`;
      const lines = [v.message, '', v.name, v.email, v.phone, v.company].filter((l, i) => i < 2 || l);
      return `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    };

    const setSending = (sending: boolean) => {
      if (!submit) return;
      submit.disabled = sending;
      submit.textContent = sending ? 'Sending…' : submitLabel;
    };
    const showDone = (v: ReturnType<typeof values>) => {
      if (doneText) doneText.textContent = `Thanks, ${v.name}. Your message is on its way to Raja, and he'll reply to ${v.email}.`;
      form.hidden = true;
      done.hidden = false;
      done.focus();
    };
    const showFailure = (v: ReturnType<typeof values>) => {
      if (!alertBox) return;
      alertBox.replaceChildren();
      const p = document.createElement('p');
      p.textContent = "Sorry, your message couldn't be sent just now. Everything you typed is still here. You can try again, or:";
      const list = document.createElement('ul');
      const mail = document.createElement('a');
      mail.href = mailtoHref(v);
      mail.textContent = 'Send it from your email app instead';
      const wa = document.createElement('a');
      wa.href = whatsapp;
      wa.textContent = 'Message Raja on WhatsApp';
      for (const a of [mail, wa]) {
        const li = document.createElement('li');
        li.append(a);
        list.append(li);
      }
      alertBox.append(p, list);
      alertBox.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (alertBox) alertBox.hidden = true;
      if (!validate()) return;
      const v = values();

      if (mode === 'mailto') {
        const href = mailtoHref(v);
        window.location.href = href;
        if (status) {
          status.replaceChildren(`Your email app should open with the message ready. If it doesn't, `);
          const a = document.createElement('a');
          a.href = href;
          a.textContent = `email ${to}`;
          a.className = 'link';
          status.append(a, '.');
        }
        return;
      }

      // Honeypot ticked: a bot. Pretend it worked and send nothing.
      if (form.querySelector<HTMLInputElement>('[data-botcheck]')?.checked) {
        showDone(v);
        return;
      }

      const subject = `Website enquiry: ${v.reason} from ${v.name}`;
      form.querySelector<HTMLInputElement>('[data-subject]')?.setAttribute('value', subject);
      const payload: Record<string, string | boolean> = {};
      new FormData(form).forEach((value, key) => {
        if (key !== 'redirect' && key !== 'botcheck') payload[key] = String(value);
      });
      if (mode === 'web3forms') {
        payload.subject = subject;
        payload.botcheck = false;
      } else {
        payload._subject = subject;
      }

      setSending(true);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || (mode === 'web3forms' && result.success === false)) throw new Error(`HTTP ${response.status}`);
        form.reset();
        showDone(v);
      } catch {
        showFailure(v);
      } finally {
        setSending(false);
      }
    });

    done.querySelector('[data-send-another]')?.addEventListener('click', () => {
      form.reset();
      for (const [name] of rules) showError(name, '');
      if (status) status.textContent = '';
      done.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name="reason"]')?.focus();
    });
  }
</script>
