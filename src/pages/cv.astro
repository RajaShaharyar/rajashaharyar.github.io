</style>

<script>
  // Experience disclosures: start with only the first role open (no-JS: all open).
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-xp-toggle]')) {
    const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (!panel) continue;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      // A data attribute, not [hidden]: Tailwind's base layer makes [hidden] display:none !important,
      // which no print rule could undo, and every role must print open.
      panel.toggleAttribute('data-collapsed', !open);
    };
    set(toggle.dataset.xpInitial === 'open');
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  }

  // Mini-menu: highlight the section being read; on phones keep that chip in view.
  const menu = document.querySelector<HTMLElement>('[data-cv-menu]');
  const links = new Map(
    Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-cv-link]')).map((a) => [a.dataset.cvLink, a]),
  );
  let current = '';
  const activate = (id: string) => {
    if (id === current) return;
    current = id;
    for (const [key, link] of links) {
      if (key === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    const link = links.get(id);
    if (menu && link && menu.scrollWidth > menu.clientWidth) {
      const left = link.offsetLeft - (menu.clientWidth - link.offsetWidth) / 2;
      menu.scrollTo({ left, behavior: 'auto' });
    }
  };
  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (visible[0]) activate(visible[0].target.id);
    },
    { rootMargin: '-25% 0px -65% 0px' },
  );
  document.querySelectorAll('[data-cv-section]').forEach((s) => observer.observe(s));
</script>
