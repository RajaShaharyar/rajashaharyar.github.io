---
/**
 * Phase 1 placeholder hero: name, title, one line.
 * Phase 2 replaces this with the full ten-section homepage.
 */
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
---

<Base>
  <section class="wrap relative pt-16 pb-20 md:pt-28 md:pb-32">
    <p class="eyebrow">{site.title} · {site.company}</p>
    <h1 class="mt-6 max-w-5xl text-display-xl">
      {site.name}<span class="text-accent" aria-hidden="true">.</span>
    </h1>
    <p class="lead mt-8 max-w-2xl">{site.tagline}</p>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href={site.cta.href} class="btn btn-primary">{site.cta.label}</a>
      <a href={site.cv.pageHref} class="btn btn-secondary">View CV</a>
    </div>

    <div class="mt-20 flex max-w-2xl items-start gap-4 border-t border-line pt-6" role="note">
      <span
        class="mt-0.5 inline-flex shrink-0 items-center rounded-full bg-accent px-3 py-1 text-sm font-semibold text-accent-ink"
      >
        Coming soon
      </span>
      <p class="text-fg-muted">
        The full homepage, with proof numbers, the Idea → Scale playbook and the ventures.
      </p>
    </div>
  </section>
</Base>
