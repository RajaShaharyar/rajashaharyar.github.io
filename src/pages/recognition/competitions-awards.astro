---
/**
 * Recognition ▾ Competitions & awards: counters, then win, top-3 and award
 * cards. University recognition sits on the win it belongs to (photos and a
 * line on the Zindigi and Startup Pitching League cards), not on its own card.
 */
import Base from '../../layouts/Base.astro';
import SubPageHeader from '../../components/SubPageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Counter from '../../components/Counter.astro';
import RecognitionCard from '../../components/RecognitionCard.astro';
import { shownOn, type Badge } from '../../lib/recognition';
import { badgeCounter, recognitionCopy, recognitionMenuEntry } from '../../lib/recognition-pages';

const page = recognitionMenuEntry('/recognition/competitions-awards/');
const { competitions } = recognitionCopy;
const sections = competitions.sections.map((s) => ({ ...s, items: shownOn('competitions-awards', s.badges as Badge[]) }));
const counters = sections.map((s) => badgeCounter(s.badges[0]));
---

<Base title={page.label} description={competitions.description}>
  <SubPageHeader section="/recognition/" overviewLabel="Overview" title={page.label} intro={`${page.description}.`} />

  <section class="wrap pt-10 md:pt-14" aria-label="Results in numbers">
    <ul class="grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line md:max-w-3xl">
      {counters.map((c) => <Counter value={c.value} label={c.label} />)}
    </ul>
  </section>

  {
    sections.map((s, i) => (
      <section
        id={s.id}
        class:list={[
          'wrap',
          i === 0 ? 'pt-14 md:pt-20' : 'border-t border-line pt-14 md:pt-20',
          i === sections.length - 1 ? 'pb-4' : 'pb-14 md:pb-20',
        ]}
        aria-labelledby={`${s.id}-heading`}
      >
        <SectionHeader id={`${s.id}-heading`} heading={s.heading} />
        <ul class="mt-8 grid gap-4 md:mt-10 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
          {s.items.map((item) => (
            <li>
              <RecognitionCard item={item} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
