---
/**
 * One route for every venture: each published MDX file in src/content/ventures
 * becomes /ventures/<file-name>/. Case studies (kind: case-study) and role
 * stories (kind: role-story) render with VentureLayout; Other ventures (kind:
 * roles) with RolesLayout.
 * A file marked status: draft is not built.
 */
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import VentureLayout from '../../layouts/VentureLayout.astro';
import RolesLayout from '../../layouts/RolesLayout.astro';

export async function getStaticPaths() {
  const ventures = await getCollection('ventures', (entry) => entry.data.status === 'published');
  return ventures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { data } = entry;
---

{data.kind === 'roles' ? <RolesLayout data={data} /> : <VentureLayout id={entry.id} data={data} />}
