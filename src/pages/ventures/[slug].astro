---
/**
 * One route for every venture: each MDX file in src/content/ventures becomes
 * /ventures/<file-name>/. Case studies (kind: case-study) render with
 * VentureLayout; Consulting & product roles (kind: roles) gets its own role
 * cards in Phase 8. A file still marked status: draft shows its stub until
 * its phase ships (Phase 7: Tapit and Ladenza; Phase 8: Consulting).
 */
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VentureLayout from '../../layouts/VentureLayout.astro';
import StubPage from '../../components/StubPage.astro';

export async function getStaticPaths() {
  const ventures = await getCollection('ventures');
  return ventures.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { data } = entry;
---

{
  data.status === 'published' && data.kind === 'case-study' ? (
    <VentureLayout id={entry.id} data={data} />
  ) : (
    <Base title={data.title} description={data.summary}>
      <StubPage eyebrow="Ventures" title={data.title} purpose={data.summary} phase={`Phase ${data.phase} · Ventures`} />
    </Base>
  )
}
