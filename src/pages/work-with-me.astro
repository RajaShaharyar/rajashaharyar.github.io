---
/**
 * Work With Me (/work-with-me), in the sitemap's order:
 * Services (#services: the four offers from site.json → offers, each with a
 * proof link into a venture page) · Working process (#process: the steps,
 * then How I work, moved from the old Skills page) · FAQ (#faq: the last
 * answer lists the four engagement models) · the closing call to action,
 * which preselects "Growth help".
 * Copy: src/content/work-with-me.json · CTA heading: home.json → finalCta
 */
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OfferCard from '../components/OfferCard.astro';
import CTA from '../components/CTA.astro';
import copy from '../content/work-with-me.json';
import home from '../content/home.json';
import { site } from '../lib/site';

const sectionY = 'py-16 md:py-20';
---

<Base title={copy.title} description={copy.description}>
  <header class="wrap pt-12 md:pt-20">
    <h1 class="max-w-4xl text-display-lg">{copy.title}</h1>
    <p class="lead mt-6 max-w-prose">{copy.intro}</p>
  </header>

  <!-- 1. Services -->
  <section id="services" class="wrap pt-12 pb-16 md:pt-16 md:pb-20" aria-labelledby="services-heading">
    <SectionHeader id="services-heading" heading={copy.offersHeading} />
    <ul class="mt-8 grid gap-4 md:mt-10 md:grid-cols-2 md:gap-6" data-reveal-stagger>
      {
        site.offers.map((offer, i) => (
          <li id={offer.id}>
            <OfferCard offer={offer} index={i} variant="full" />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 2. Working process: the steps, then how I work -->
  <section id="process" class:list={['wrap border-t border-line', sectionY]} aria-labelledby="process-heading">
    <SectionHeader id="process-heading" heading={copy.steps.heading} />
    <ol class="steps mt-8 md:mt-10" data-reveal-stagger>
      {
        copy.steps.items.map((step, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="step-label">{step}</span>
          </li>
        ))
      }
    </ol>

    <h3 id="how-i-work" class="mt-16 text-2xl md:mt-20 md:text-[1.75rem]">{copy.howIWork.heading}</h3>
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:gap-6" data-reveal-stagger>
      {
        copy.howIWork.items.map((item, i) => (
          <li class="flex flex-col rounded-card border border-line bg-surface p-6 md:p-8">
            <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h4 class="mt-4 font-display text-2xl leading-tight font-semibold tracking-tight md:text-[1.75rem]">{item.principle}</h4>
            <div class="mt-6 border-t border-line pt-5">
              <p class="text-xs font-semibold tracking-[0.14em] text-fg-subtle uppercase">{copy.howIWork.proofLabel}</p>
              <p class="mt-2 text-fg-muted">{item.proof}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 3. FAQ -->
  <section id="faq" class:list={['wrap border-t border-line', sectionY]} aria-labelledby="faq-heading">
    <SectionHeader id="faq-heading" heading={copy.faq.heading} />
    <div class="faq mt-8 md:mt-10">
      {
        copy.faq.items.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">
              {item.q}
              <svg class="faq-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M4 6l4 4 4-4" />
              </svg>
            </summary>
            {'a' in item && item.a && <p class="faq-a">{item.a}</p>}
            {'models' in item && item.models && (
              <ul class="faq-a faq-models">
                {item.models.map((m) => (
                  <li class="chip">{m}</li>
                ))}
              </ul>
            )}
          </details>
        ))
      }
    </div>
  </section>

  <!-- 4. Closing call to action: preselects "Growth help" on the contact form -->
  <section class="wrap pt-4 pb-4" aria-labelledby="wwm-cta-heading">
    <CTA heading={home.finalCta.heading} href={copy.cta.href} label={copy.cta.label} headingId="wwm-cta-heading" />
  </section>
</Base>

<style>
  .steps {
    display: grid;
    gap: 0.75rem;
  }
  @media (width >= 48rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.375rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .step-label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-fg);
  }

  .faq {
    max-width: 48rem;
    border-top: 1px solid var(--color-line);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 0.875rem 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-fg);
    cursor: pointer;
    list-style: none;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex: none;
    fill: none;
    stroke: var(--color-fg-muted);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s var(--ease-out-quart);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-a {
    padding: 0 0 1.25rem;
    max-width: var(--container-prose);
    color: var(--color-fg-muted);
  }
  .faq-models {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
